5960, 0.0071),\n    (\"Fashion-MNIST\", \"independent\", 210.63, 1.01, 0.6172, 0.0020),\n    (\"Fashion-MNIST\", \"minibatch OT\", 173.59, 0.80, 0.5964, 0.0026),\n]\ndf_eta = pd.DataFrame(eta_rows, columns=[\"Dataset\",\"Coupling\",\"Proxy gap mean\",\"Proxy gap sd\",\"eta mean\",\"eta sd\"])\ndisplay(df_eta)\n\n# Conservative pairwise difference calculation.\n# If +/- is SD over 3 seeds: SE_diff = sqrt(sd1^2/3 + sd2^2/3).\n# If +/- is SE already: SE_diff = sqrt(se1^2 + se2^2).\nn_seeds = 3\nsummary = []\nfor dataset in df_eta[\"Dataset\"].unique():\n    a = df_eta[(df_eta.Dataset==dataset)&(df_eta.Coupling==\"independent\")].iloc[0]\n    b = df_eta[(df_eta.Dataset==dataset)&(df_eta.Coupling==\"minibatch OT\")].iloc[0]\n    diff = a[\"eta mean\"] - b[\"eta mean\"]\n    se_if_sd = math.sqrt(a[\"eta sd\"]**2/n_seeds + b[\"eta sd\"]**2/n_seeds)\n    se_if_se = math.sqrt(a[\"eta sd\"]**2 + b[\"eta sd\"]**2)\n    summary.append({\n        \"Dataset\": dataset,\n        \"eta diff (indep - OT)\": diff,\n        \"t if +/- is SD\": diff/se_if_sd,\n        \"t if +/- is SE\": diff/se_if_se,\n        \"conservative interpretation\": \"clear\" if diff/se_if_se >= 2 else \"directional / within error\",\n    })\ndf_eta_sig = pd.DataFrame(summary)\ndisplay(df_eta_sig)\ndf_eta.to_csv(OUTPUT_DIR / \"normalized_eta_supplied.csv\", index=False)\ndf_eta_sig.to_csv(OUTPUT_DIR / \"normalized_eta_interpretation.csv\", index=False)","metadata":{"execution":{"iopub.status.busy":"2026-07-24T17:55:13.725437Z","iopub.execute_input":"2026-07-24T17:55:13.725907Z","iopub.status.idle":"2026-07-24T17:55:13.749333Z","shell.execute_reply.started":"2026-07-24T17:55:13.725882Z","shell.execute_reply":"2026-07-24T17:55:13.748526Z"},"trusted":true},"outputs":[{"output_type":"display_data","data":{"text/plain":"         Dataset      Coupling  Proxy gap mean  Proxy gap sd  eta mean  eta sd\n0       CIFAR-10   independent          484.80          4.36    0.6024  0.0058\n1       CIFAR-10  minibatch OT          430.40          2.58    0.5960  0.0071\n2  Fashion-MNIST   independent          210.63          1.01    0.6172  0.0020\n3  Fashion-MNIST  minibatch OT          173.59          0.80    0.5964  0.0026","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>Dataset</th>\n      <th>Coupling</th>\n      <th>Proxy gap mean</th>\n      <th>Proxy gap sd</th>\n      <th>eta mean</th>\n      <th>eta sd</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>CIFAR-10</td>\n      <td>independent</td>\n      <td>484.80</td>\n      <td>4.36</td>\n      <td>0.6024</td>\n      <td>0.0058</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>CIFAR-10</td>\n      <td>minibatch OT</td>\n      <td>430.40</td>\n      <td>2.58</td>\n      <td>0.5960</td>\n      <td>0.0071</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>Fashion-MNIST</td>\n      <td>independent</td>\n      <td>210.63</td>\n      <td>1.01</td>\n      <td>0.6172</td>\n      <td>0.0020</td>\n    </tr>\n    <tr>\n      <th>3</th>\n      <td>Fashion-MNIST</td>\n      <td>minibatch OT</td>\n      <td>173.59</td>\n      <td>0.80</td>\n      <td>0.5964</td>\n      <td>0.0026</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"         Dataset  eta diff (indep - OT)  t if +/- is SD  t if +/- is SE  \\\n0       CIFAR-10                 0.0064        1.209127        0.698090   \n1  Fashion-MNIST                 0.0208       10.982920        6.340992   \n\n  conservative interpretation  \n0  directional / within error  \n1                       clear  ","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>Dataset</th>\n      <th>eta diff (indep - OT)</th>\n      <th>t if +/- is SD</th>\n      <th>t if +/- is SE</th>\n      <th>conservative interpretation</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>CIFAR-10</td>\n      <td>0.0064</td>\n      <td>1.209127</td>\n      <td>0.698090</td>\n      <td>directional / within error</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>Fashion-MNIST</td>\n      <td>0.0208</td>\n      <td>10.982920</td>\n      <td>6.340992</td>\n      <td>clear</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":15},{"id":"bd2061a0","cell_type":"markdown","source":"## 7. Rebuttal-ready text\n\nThe next cell writes a concise rebuttal paragraph addressing:\n\n- mathematical novelty beyond \\(L^2\\) projection;\n- broader bridge/coupling validation;\n- proxy nature;\n- transport-cost baseline and zero-cost-proxy comparison;\n- counterexample / failure mode;\n- apples-to-oranges timing caveat;\n- \\(U\\) and \\(\\mathcal O\\) not being free knobs.","metadata":{}},{"id":"c60a7edc","cell_type":"code","source":"rebuttal_text = r'''\nWe thank the reviewers for the precise questions. We agree that the projection proof itself is the classical \\(L^2\\) conditional-expectation identity. The contribution is to make the residual of that projection a bridge-design quantity. In revision we will define the general diagnostic as\n\\[\n\\mathfrak G(\\mathscr Q,U,\\mathcal O)\n=\n\\int_0^1\\mathbb E_{\\mathscr Q}\\operatorname{Tr}\\operatorname{Var}(U_t\\mid S_t)\\,dt,\n\\qquad S_t=\\mathcal O_t(X_t),\n\\]\nwhere \\(U_t\\) is the local target fixed by the bridge/training objective and \\(S_t\\) is the sampler-visible state fixed by the model under analysis. These are not free parameters chosen post hoc: to compare designs, we keep \\((U,\\mathcal O)\\) fixed and vary the coupling or bridge law. For deterministic bridges \\(U_t=\\partial_t X_t\\); for stochastic bridges \\(U_t\\) is the chosen matching target, such as a controlled drift, current velocity, or score/velocity representation. If memory or extra latent state is allowed, it changes \\(\\mathcal O\\) and therefore changes the diagnostic; the gap is a bottleneck for a specified decoder information state, not an impossibility result for all samplers.\n\nTo address the concern that the image results are proxy-based and narrow, we added a controlled 3D Gaussian--OT experiment where the gap is computed exactly from Gaussian conditional covariances, with no kNN/PCA estimator and no neural training. The experiment fixes the same base and target marginals and varies coupling, bridge law, and sampler-visible state. A straight deterministic Monge OT bridge has zero full-state gap because the bridge is injective. Noisy OT couplings and independent coupling have positive gaps that increase as endpoint information is degraded. With the same Monge endpoint coupling and endpoint cost, replacing the straight bridge by a Brownian bridge gives a positive gap, showing that the diagnostic varies along the bridge-law axis. Projecting the same 3D straight Monge bridge from the full state to a 2D or 1D visible state also creates positive gap while leaving endpoint cost and velocity variance unchanged. Thus the gap is not merely transport cost or path length; it depends on bridge law and on the information visible to the Markov decoder.\n\nFor the image experiments, we will state explicitly that the reported quantity is a feature-space finite-bandwidth proxy \\(\\widehat{\\mathfrak G}_{\\phi,k}\\), used only for within-dataset ranking, not a certified population lower bound. As a baseline against simple zero-cost proxies, we report endpoint cost / velocity variance and the normalized unexplained-variance fraction\n\\[\n\\eta=\n\\frac{\\int_0^1\\mathbb E\\operatorname{Tr}\\operatorname{Var}(U_t\\mid S_t)\\,dt}\n{\\int_0^1\\mathbb E\\operatorname{Tr}\\operatorname{Var}(U_t)\\,dt}.\n\\]\nThis controls for the marginal velocity scale. The exact Gaussian ablation shows cases with identical endpoint cost and velocity variance but different gap, which simple transport-cost proxies cannot distinguish. In the image pilots, Fashion-MNIST shows a clear reduction in \\(\\eta\\) from \\(0.6172\\pm0.0020\\) to \\(0.5964\\pm0.0026\\). On CIFAR-10, the \\(\\eta\\) change from \\(0.6024\\pm0.0058\\) to \\(0.5960\\pm0.0071\\) is directionally consistent but within reported uncertainty, so we do not use it as strong evidence. We instead rely on the exact Gaussian control and the Fashion-MNIST normalized result to address the transport-cost confound.\n\nWe will also clarify computational cost. For \\(n\\) endpoint pairs, \\(T\\) time points, visible dimension \\(d_s\\), target dimension \\(d_u\\), and \\(k\\) neighbors, the brute-force proxy costs\n\\[\nO(C_{\\rm pair}+Tn(d_s+d_u)+Tn^2d_s+Tnkd_u),\n\\]\nwhere \\(C_{\\rm pair}\\) is the coupling cost. With approximate or tree-based nearest-neighbor search the practical cost is closer to \\(O(C_{\\rm pair}+Tn d_s\\log n+Tnk(d_s+d_u))\\), but the quadratic bound is the safe worst case. Independent coupling has \\(C_{\\rm pair}=O(n)\\); minibatch OT with batch size \\(b\\) and cost dimension \\(d_c\\) costs \\(O(nb d_c+nb^2)\\) with Hungarian assignment. We will call the estimator a cheap pre-training diagnostic, not a zero-cost NAS proxy. NAS proxies such as gradient norm or SynFlow are architecture-level scores; our baseline comparison is instead to bridge-design proxies such as endpoint cost and velocity variance.\n\nFinally, we will state failure modes explicitly. A lower-gap bridge can perform worse if it induces stiff or highly curved dynamics tha
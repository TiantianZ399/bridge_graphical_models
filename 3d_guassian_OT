Markovization gap from endpoint cost and velocity scale. Rows with the same endpoint cost can have different gap when the bridge law or sampler-visible state changes.}\")\n    lines.append(r\"\\label{tab:gap_vs_energy_controls}\")\n    lines.append(r\"\\begin{tabular}{@{}lcccc@{}}\")\n    lines.append(r\"\\toprule\")\n    lines.append(r\"Configuration & Endpoint cost & Velocity variance & Exact gap $\\downarrow$ & Normalized $\\eta\\downarrow$ \\\\\")\n    lines.append(r\"\\midrule\")\n    for _, r in df.iterrows():\n        lines.append(f\"{r['Configuration']} & ${r['Endpoint cost']:.3f}$ & ${r['Velocity variance']:.3f}$ & ${r['Exact gap']:.3f}$ & ${r['Normalized eta']:.3f}$ \\\\\\\\\")\n    lines.append(r\"\\bottomrule\")\n    lines.append(r\"\\end{tabular}\")\n    lines.append(r\"\\end{table}\")\n    return \"\\n\".join(lines)\n\ntable_controls_tex = latex_controls_table(df_controls)\nprint(table_controls_tex)\n(OUTPUT_DIR / \"table_gap_vs_transport_controls.tex\").write_text(table_controls_tex)","metadata":{"execution":{"iopub.status.busy":"2026-07-24T17:06:31.977131Z","iopub.execute_input":"2026-07-24T17:06:31.977813Z","iopub.status.idle":"2026-07-24T17:06:31.986209Z","shell.execute_reply.started":"2026-07-24T17:06:31.97779Z","shell.execute_reply":"2026-07-24T17:06:31.985642Z"},"trusted":true},"outputs":[{"name":"stdout","text":"\\begin{table}[t]\n\\centering\n\\small\n\\caption{Exact controls separating Markovization gap from endpoint cost and velocity scale. Rows with the same endpoint cost can have different gap when the bridge law or sampler-visible state changes.}\n\\label{tab:gap_vs_energy_controls}\n\\begin{tabular}{@{}lcccc@{}}\n\\toprule\nConfiguration & Endpoint cost & Velocity variance & Exact gap $\\downarrow$ & Normalized $\\eta\\downarrow$ \\\\\n\\midrule\nstraight, full state & $1.222$ & $1.100$ & $0.000$ & $0.000$ \\\\\nstraight, 2D projection & $1.222$ & $1.100$ & $0.123$ & $0.112$ \\\\\nstraight, 1D projection & $1.222$ & $1.100$ & $0.491$ & $0.447$ \\\\\nBrownian, full state & $1.222$ & $4.167$ & $3.494$ & $0.839$ \\\\\nstraight independent, full state & $10.500$ & $9.450$ & $6.735$ & $0.713$ \\\\\n\\bottomrule\n\\end{tabular}\n\\end{table}\n","output_type":"stream"},{"execution_count":11,"output_type":"execute_result","data":{"text/plain":"804"},"metadata":{}}],"execution_count":11},{"id":"bef7f836","cell_type":"markdown","source":"## 5. Optional GPU-capable image proxy estimator\n\nThe cells below can recompute a feature-space proxy gap and normalized \\(\\eta\\) on CIFAR-10 or Fashion-MNIST. They use PyTorch and will use CUDA when available.\n\nThis is **not** required for the exact 3D rebuttal experiment. It is included if you want to update the image-proxy tables with the same notebook. The image proxy remains a finite-sample, feature-space ranking score, not a certified population gap.","metadata":{}},{"id":"05387236","cell_type":"code","source":"# Set RUN_IMAGE_PROXY = True on Kaggle if you want to recompute CIFAR/Fashion-MNIST proxy controls.\nRUN_IMAGE_PROXY = True\n\nIMAGE_CONFIG = {\n    \"datasets\": [\"CIFAR10\", \"FashionMNIST\"],\n    \"n\": 1024,\n    \"seeds\": [0, 1, 2],\n    \"pca_dim\": 64,\n    \"k\": 32,\n    \"num_times\": 19,\n    \"t_min\": 0.05,\n    \"t_max\": 0.95,\n    \"ot_batch\": 128,\n    \"data_root\": \"/kaggle/working/data\" if Path(\"/kaggle\").exists() else \"./data\",\n}\nIMAGE_CONFIG","metadata":{"execution":{"iopub.status.busy":"2026-07-24T17:06:31.987027Z","iopub.execute_input":"2026-07-24T17:06:31.987343Z","iopub.status.idle":"2026-07-24T17:06:32.00922Z","shell.execute_reply.started":"2026-07-24T17:06:31.98732Z","shell.execute_reply":"2026-07-24T17:06:32.008643Z"},"trusted":true},"outputs":[{"execution_count":12,"output_type":"execute_result","data":{"text/plain":"{'datasets': ['CIFAR10', 'FashionMNIST'],\n 'n': 1024,\n 'seeds': [0, 1, 2],\n 'pca_dim': 64,\n 'k': 32,\n 'num_times': 19,\n 't_min': 0.05,\n 't_max': 0.95,\n 'ot_batch': 128,\n 'data_root': '/kaggle/working/data'}"},"metadata":{}}],"execution_count":12},{"id":"0187b5d9","cell_type":"code","source":"# Optional GPU image proxy code. This cell defines functions only.\n# It does not download data unless RUN_IMAGE_PROXY=True below.\n\ndef _ensure_image_deps():\n    import importlib, subprocess, sys\n    for pkg in [\"torch\", \"torchvision\", \"sklearn\", \"scipy\"]:\n        try:\n            importlib.import_module(pkg if pkg != \"sklearn\" else \"sklearn\")\n        except Exception:\n            subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", pkg])\n\ndef load_dataset_features(dataset_name, n, seed, pca_dim, data_root):\n    from torchvision import datasets, transforms\n    from sklearn.decomposition import PCA\n    from sklearn.preprocessing import StandardScaler\n    import torch\n    rng = np.random.default_rng(seed)\n\n    if dataset_name == \"CIFAR10\":\n        transform = transforms.Compose([\n            transforms.Resize((8,8)),\n            transforms.ToTensor(),\n        ])\n        ds = datasets.CIFAR10(root=data_root, train=True, download=True, transform=transform)\n        idx = rng.choice(len(ds), size=n, replace=False)\n        xs = []\n        for i in idx:\n            x, _ = ds[int(i)]\n            xs.append(x.reshape(-1).numpy())\n        Xraw = np.stack(xs, axis=0).astype(np.float64)\n    elif dataset_name == \"FashionMNIST\":\n        transform = transforms.Compose([\n            transforms.Resize((8,8)),\n            transforms.ToTensor(),\n        ])\n        ds = datasets.FashionMNIST(root=data_root, train=True, download=True, transform=transform)\n        idx = rng.choice(len(ds), size=n, replace=False)\n        xs = []\n        for i in idx:\n            x, _ = ds[int(i)]\n            xs.append(x.reshape(-1).numpy())\n        Xraw = np.stack(xs, axis=0).astype(np.float64)\n    else:\n        raise ValueError(dataset_name)\n\n    scaler = StandardScaler()\n    Xs = scaler.fit_transform(Xraw)\n    pca = PCA(n_components=min(pca_dim, Xs.shape[1]), random_state=seed)\n    Xfeat = pca.fit_transform(Xs)\n    # Standardize PCA features to comparable scale for the proxy\n    Xfeat = (Xfeat - Xfeat.mean(axis=0, keepdims=True)) / (Xfeat.std(axis=0, keepdims=True) + 1e-8)\n    return Xfeat.astype(np.float32)\n\ndef minibatch_ot_pair(Z, X, batch_size=128):\n    from scipy.optimize import linear_sum_assignment\n    n = Z.shape[0]\n    perm = np.empty(n, dtype=np.int64)\n    for start in range(0, n, batch_size):\n        end = min(start + batch_size, n)\n        zb = Z[start:end]\n        xb = X[start:end]\n        # squared Euclidean cost\n        cost = ((zb[:, None, :] - xb[None, :, :]) ** 2).sum(axis=-1)\n        row, col = linear_sum_assignment(cost)\n        # row is usually 0..b-1; assign each base row to selected target row within the same block\n        block_perm = np.arange(start, end)\n        perm[start + row] = start + col\n    return X[perm]\n\ndef knn_proxy_gap_torch(Z_np, X_np, k=32, num_times=19, t_min=0.05, t_max=0.95, device=None):\n    import torch\n    if device is None:\n        device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n    Z = torch.tensor(Z_np, dtype=torch.float32, device=device)\n    X = torch.tensor(X_np, dtype=torch.float32, device=device)\n    U = X - Z\n    n = Z.shape[0]\n    k_eff = min(k, n-1)\n    times = torch.linspace(t_min, t_max, num_times, device=device)\n    gaps, totals = [], []\n    for t in times:\n        S = (1-t) * Z + t * X\n        # Exact distance matrix. For n=1024 this is fine on GPU.\n        D = torch.cdist(S, S, p=2)\n        # Leave-one-out neighbors: remove self by setting diagonal to infinity\n        D.fill_diagonal_(float(\"inf\"))\n        nn = torch.topk(D, k=k_eff, largest=False).indices\n        U_mean = U[nn].mean(dim=1)\n        residual = U - U_mean\n        gap = (residual.pow(2).sum(dim=1)).mean()\n        # marginal variance around mean\n        U_center = U - U.mean(dim=0, keepdim=True)\n        total = (U_center.pow(2).sum(dim=1)).mean()\n        gaps.append(gap)\n        totals.append(total)\n    gaps = torch.stack(gaps)\n    totals = torch.stack(totals)\n    # Trapezoid over time. Times equally spaced.\n    gap_auc = torch.trapezoid(gaps, times).item()\n    total_auc = torch.trapezoid(totals, times).item()\n    eta = gap_auc / total_auc if total_auc > 0 else float(\"nan\")\n    endpoint_cost = ((X - Z).pow(2).sum(dim=1)).mean().item()\n    return {\n        \"proxy_gap\": gap_auc,\n        \"velocity_variance\": total_auc,\n        \"eta\": eta,\n        \"endpoint_cost\": endpoint_cost,\n        \"device\": device,\n    }\n\ndef run_image_proxy_experiment(config):\n    import torch\n    device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n    print(\"Using device:\", device)\n    rows = []\n    for dataset in config[\"datasets\"]:\n        for seed in config[\"seeds\"]:\n            rng = np.random.default_rng(seed)\n            X = load_dataset_features(dataset, config[\"n\"], seed, config[\"pca_dim\"], config[\"data_root\"])\n            Z = rng.normal(size=X.shape).astype(np.float32)\n            for coupling in [\"independent\", \"minibatch OT\"]:\n                if coupling == \"independent\":\n                    X_pair = X.copy()\n                    rng.shuffle(X_pair)\n                else:\n                    X_pair = minibatch_ot_pair(Z, X, batch_size=config[\"ot_batch\"])\n                res = knn_proxy_gap_torch(\n                    Z, X_pair, k=config[\"k\"], num_times=config[\"num_times\"],\n                    t_min=config[\"t_min\"], t_max=config[\"t_max\"], device=device\n                )\n                rows.append({\n                    \"Dataset\": dataset,\n                    \"Seed\": seed,\n                    \"Coupling\": coupling,\n                    **res\n                })\n                print(dataset, seed, coupling, res)\n    df = pd.DataFrame(rows)\n    summary = df.groupby([\"Dataset\",\"Coupling\"]).agg(\n        proxy_gap_mean=(\"proxy_gap\",\"mean\"),\n        proxy_gap_std=(\"proxy_gap\",\"std\"),\n        eta_mean=(\"eta\",\"mean\"),\n        eta_std=(\"eta\",\"std\"),\n        endpoint_cost_mean=(\"endpoint_cost\",\"mean\"),\n        endpoint_cost_std=(\"endpoint_cost\",\"std\"),\n        velocity_variance_mean=(\"velocity_variance\",\"mean\"),\n        velocity_variance_std=(\"velocity_variance\",\"std\"),\n    ).reset_index()\n    return df, summary","metadata":{"execution":{"iopub.status.busy":"2026-07-24T17:06:32.009981Z","iopub.execute_input":"2026-07-24T17:06:32.010742Z","iopub.status.idle":"2026-07-24T17:06:32.031882Z","shell.execute_reply.started":"2026-07-24T17:06:32.010721Z","shell.execute_reply":"2026-07-24T17:06:32.031132Z"},"trusted":true},"outputs":[],"execution_count":13},{"id":"28abc608","cell_type":"code","source":"if RUN_IMAGE_PROXY:\n    _ensure_image_deps()\n    df_img, summary_img = run_image_proxy_experiment(IMAGE_CONFIG)\n    display(summary_img)\n    df_img.to_csv(OUTPUT_DIR / \"image_proxy_by_seed.csv\", index=False)\n    summary_img.to_csv(OUTPUT_DIR / \"image_proxy_summary.csv\", index=False)\nelse:\n    print(\"RUN_IMAGE_PROXY is False. Set it to True above to recompute CIFAR/Fashion-MNIST GPU proxy controls.\")","metadata":{"execution":{"iopub.status.busy":"2026-07-24T17:06:32.032756Z","iopub.execute_input":"2026-07-24T17:06:32.032975Z","iopub.status.idle":"2026-07-24T17:55:13.72228Z","shell.execute_reply.started":"2026-07-24T17:06:32.032956Z","shell.execute_reply":"2026-07-24T17:55:13.721654Z"},"trusted":true},"outputs":[{"name":"stdout","text":"Using device: cuda\n","output_type":"stream"},{"name":"stderr","text":"100%|██████████| 170M/170M [48:18<00:00, 58.8kB/s]]\n","output_type":"stream"},{"name":"stdout","text":"CIFAR10 0 independent {'proxy_gap': 112.56688690185547, 'velocity_variance': 115.37432098388672, 'eta': 0.9756667336536409, 'endpoint_cost': 128.25479125976562, 'device': 'cuda'}\nCIFAR10 0 minibatch OT {'proxy_
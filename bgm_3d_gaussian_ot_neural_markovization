222083</td>\n      <td>0.575385</td>\n      <td>0.517847</td>\n      <td>1.222083</td>\n      <td>0.470824</td>\n    </tr>\n    <tr>\n      <th>3</th>\n      <td>brownian</td>\n      <td>monge</td>\n      <td>full3d</td>\n      <td>1.222083</td>\n      <td>3.882104</td>\n      <td>3.493893</td>\n      <td>4.629552</td>\n      <td>0.838549</td>\n    </tr>\n    <tr>\n      <th>4</th>\n      <td>brownian</td>\n      <td>monge</td>\n      <td>proj2d</td>\n      <td>1.222083</td>\n      <td>4.001444</td>\n      <td>3.601300</td>\n      <td>4.629552</td>\n      <td>0.864326</td>\n    </tr>\n    <tr>\n      <th>5</th>\n      <td>brownian</td>\n      <td>monge</td>\n      <td>proj1d</td>\n      <td>1.222083</td>\n      <td>4.217886</td>\n      <td>3.796098</td>\n      <td>4.629552</td>\n      <td>0.911079</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":6},{"id":"bdb5cd07","cell_type":"markdown","source":"\n## 4. Neural regression sanity check\n\nA small MLP is trained on GPU, if available, to predict \\(U_t\\) from the visible state and time. The oracle Gaussian conditional mean should attain the exact average gap. The MLP should approach it.\n","metadata":{}},{"id":"8f943e23","cell_type":"code","source":"\ndef sample_numpy(n, bridge, coupling, obs='full3d', eps=BROWNIAN_EPS, seed=None):\n    rng = np.random.default_rng(seed)\n    z = rng.standard_normal((n, D))\n    if coupling == 'monge':\n        x = z @ L.T\n    elif coupling.startswith('noisy'):\n        sigma = float(coupling.split('_')[1])\n        A = sym_sqrtm(Sigma - (sigma**2) * I3)\n        x = z @ A.T + sigma * rng.standard_normal((n, D))\n    elif coupling == 'independent':\n        x = rng.standard_normal((n, D)) @ L.T\n    else:\n        raise ValueError(coupling)\n    t = rng.uniform(T_MIN, T_MAX, size=(n, 1))\n    eta = rng.standard_normal((n, D))\n    if bridge == 'straight':\n        xt = (1 - t) * z + t * x\n        u = x - z\n    elif bridge == 'brownian':\n        s = np.sqrt(eps * t * (1 - t))\n        xt = (1 - t) * z + t * x + s * eta\n        u = (x - xt) / (1 - t)\n    else:\n        raise ValueError(bridge)\n    P = OBS_MATS[obs]\n    s_vis = xt @ P.T\n    inp = np.concatenate([s_vis, t], axis=1)\n    return inp.astype(np.float32), u.astype(np.float32), t.astype(np.float64), s_vis.astype(np.float64)\n\ndef oracle_predict_numpy(t_arr, s_vis, bridge, coupling, obs='full3d', eps=BROWNIAN_EPS):\n    preds = np.zeros((len(t_arr), D), dtype=np.float64)\n    for i, t in enumerate(t_arr.reshape(-1)):\n        _, Sig_SS, Sig_US = instantaneous_covs(float(t), bridge, coupling, obs, eps)\n        K = Sig_US @ np.linalg.pinv(Sig_SS, rcond=1e-10)\n        preds[i] = K @ s_vis[i]\n    return preds.astype(np.float32)\n\nclass VelocityMLP(nn.Module):\n    def __init__(self, input_dim, hidden=HIDDEN):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Linear(input_dim, hidden), nn.SiLU(),\n            nn.Linear(hidden, hidden), nn.SiLU(),\n            nn.Linear(hidden, hidden), nn.SiLU(),\n            nn.Linear(hidden, 3),\n        )\n    def forward(self, x):\n        return self.net(x)\n\ndef sample_torch_batch(batch_size, bridge, coupling, obs='full3d', device=DEVICE):\n    inp, u, _, _ = sample_numpy(batch_size, bridge, coupling, obs, seed=None)\n    return torch.tensor(inp, device=device), torch.tensor(u, device=device)\n\ndef evaluate_model(model, bridge, coupling, obs='full3d', n=TEST_N, seed=999):\n    inp, u, t, s_vis = sample_numpy(n, bridge, coupling, obs, seed=seed)\n    x_torch = torch.tensor(inp, device=DEVICE)\n    with torch.no_grad():\n        pred = model(x_torch).cpu().numpy()\n    mlp_mse = float(np.mean(np.sum((pred - u)**2, axis=1)))\n    oracle_pred = oracle_predict_numpy(t, s_vis, bridge, coupling, obs)\n    oracle_mse = float(np.mean(np.sum((oracle_pred - u)**2, axis=1)))\n    return mlp_mse, oracle_mse\n\ndef train_one_config(bridge, coupling, obs='full3d', steps=N_STEPS, seed=SEED):\n    torch.manual_seed(seed); np.random.seed(seed)\n    input_dim = OBS_MATS[obs].shape[0] + 1\n    model = VelocityMLP(input_dim).to(DEVICE)\n    opt = torch.optim.AdamW(model.parameters(), lr=LR, weight_decay=1e-5)\n    start = time.time()\n    for step in range(1, steps+1):\n        x_batch, u_batch = sample_torch_batch(BATCH_SIZE, bridge, coupling, obs, DEVICE)\n        pred = model(x_batch)\n        loss = torch.mean(torch.sum((pred - u_batch)**2, dim=1))\n        opt.zero_grad(set_to_none=True)\n        loss.backward()\n        opt.step()\n        if step == 1 or step % PRINT_EVERY == 0 or step == steps:\n            elapsed = (time.time() - start)/60\n            print(f'{bridge}/{coupling}/{obs} step={step:05d}/{steps} loss={loss.item():.6f} elapsed={elapsed:.1f}m')\n    mlp_mse, oracle_mse = evaluate_model(model, bridge, coupling, obs, n=TEST_N, seed=seed+987)\n    exact = exact_gap_summary(bridge, coupling, obs)\n    return {\n        'bridge': bridge, 'coupling': coupling, 'obs': obs,\n        'exact_avg_gap': exact['avg_gap'],\n        'exact_integrated_gap': exact['integrated_gap'],\n        'exact_eta': exact['eta'],\n        'oracle_test_mse': oracle_mse,\n        'mlp_test_mse': mlp_mse,\n        'mlp_over_gap': mlp_mse / exact['avg_gap'] if exact['avg_gap'] > 1e-12 else np.nan,\n        'endpoint_cost': exact['endpoint_cost'],\n        'avg_velocity_variance': exact['avg_velocity_variance'],\n    }\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-25T02:34:04.163043Z","iopub.execute_input":"2026-07-25T02:34:04.163639Z","iopub.status.idle":"2026-07-25T02:34:04.280835Z","shell.execute_reply.started":"2026-07-25T02:34:04.163611Z","shell.execute_reply":"2026-07-25T02:34:04.280116Z"}},"outputs":[],"execution_count":8},{"id":"ce0943fb","cell_type":"code","source":"\nTRAIN_CONFIGS = [\n    ('straight', 'monge', 'full3d'),\n    ('straight', 'monge', 'proj2d'),\n    ('straight', 'monge', 'proj1d'),\n    ('straight', 'noisy_0.6', 'full3d'),\n    ('straight', 'independent', 'full3d'),\n    ('brownian', 'monge', 'full3d'),\n    ('brownian', 'independent', 'full3d'),\n]\n\nneural_results = []\nif RUN_NEURAL:\n    for bridge, coupling, obs in TRAIN_CONFIGS:\n        print('\\n' + '='*80)\n        print('Training config:', bridge, coupling, obs)\n        print('='*80)\n        res = train_one_config(bridge, coupling, obs, steps=N_STEPS, seed=SEED)\n        neural_results.append(res)\n        pd.DataFrame(neural_results).to_csv(OUT_DIR / 'neural_regression_sanity_partial.csv', index=False)\nelse:\n    print('RUN_NEURAL=False, skipping neural training.')\n\nneural_df = pd.DataFrame(neural_results)\nif len(neural_df):\n    neural_df.to_csv(OUT_DIR / 'neural_regression_sanity.csv', index=False)\n    display(neural_df[['bridge','coupling','obs','exact_avg_gap','oracle_test_mse','mlp_test_mse','mlp_over_gap','exact_integrated_gap','exact_eta']])\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-25T02:34:05.990525Z","iopub.execute_input":"2026-07-25T02:34:05.99129Z","iopub.status.idle":"2026-07-25T02:36:48.43279Z","shell.execute_reply.started":"2026-07-25T02:34:05.99126Z","shell.execute_reply":"2026-07-25T02:36:48.432055Z"}},"outputs":[{"name":"stdout","text":"\n================================================================================\nTraining config: straight monge full3d\n================================================================================\nstraight/monge/full3d step=00001/6000 loss=1.232937 elapsed=0.0m\nstraight/monge/full3d step=01000/6000 loss=0.000030 elapsed=0.1m\nstraight/monge/full3d step=02000/6000 loss=0.000005 elapsed=0.1m\nstraight/monge/full3d step=03000/6000 loss=0.000026 elapsed=0.1m\nstraight/monge/full3d step=04000/6000 loss=0.000066 elapsed=0.2m\nstraight/monge/full3d step=05000/6000 loss=0.000053 elapsed=0.2m\nstraight/monge/full3d step=06000/6000 loss=0.000062 elapsed=0.3m\n","output_type":"stream"},{"name":"stderr","text":"/tmp/ipykernel_58/2574754
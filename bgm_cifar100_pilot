ikit-learn scipy pandas tqdm pillow matplotlib\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-24T18:56:48.761239Z","iopub.execute_input":"2026-07-24T18:56:48.761581Z","iopub.status.idle":"2026-07-24T18:56:53.94643Z","shell.execute_reply.started":"2026-07-24T18:56:48.761551Z","shell.execute_reply":"2026-07-24T18:56:53.945684Z"}},"outputs":[{"name":"stdout","text":"\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m85.6/85.6 kB\u001b[0m \u001b[31m1.1 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0ma \u001b[36m0:00:01\u001b[0m\n\u001b[?25h","output_type":"stream"}],"execution_count":1},{"id":"1cec0671","cell_type":"code","source":"\nimport os, json, math, time, random, shutil, subprocess, sys\nfrom pathlib import Path\nfrom dataclasses import dataclass, asdict\nfrom typing import Dict, List, Tuple, Optional\n\nimport numpy as np\nimport pandas as pd\nfrom tqdm.auto import tqdm\n\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom torch.utils.data import DataLoader, Subset\nfrom torchvision import datasets, transforms\nfrom PIL import Image\nfrom scipy.optimize import linear_sum_assignment\nfrom sklearn.decomposition import PCA\n\nDEVICE = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\nprint('Using device:', DEVICE)\nif torch.cuda.is_available():\n    print(torch.cuda.get_device_name(0))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-24T18:56:53.948104Z","iopub.execute_input":"2026-07-24T18:56:53.948378Z","iopub.status.idle":"2026-07-24T18:57:02.758876Z","shell.execute_reply.started":"2026-07-24T18:56:53.948305Z","shell.execute_reply":"2026-07-24T18:57:02.75798Z"}},"outputs":[{"name":"stdout","text":"Using device: cuda\nTesla T4\n","output_type":"stream"}],"execution_count":2},{"id":"b01b5c7c","cell_type":"markdown","source":"\n## Configuration\n\nUse `MODE='smoke'` to debug quickly. Use `MODE='pilot'` for a few-GPU-hour CIFAR-100 run. `MODE='strong'` is optional and should be run only if you have spare GPU quota.\n","metadata":{}},{"id":"f6548feb","cell_type":"code","source":"\nMODE = 'pilot'  # 'smoke', 'pilot', or 'strong'\nDATASET_NAME = 'CIFAR100'\nOUT_ROOT = Path('/kaggle/working/bgm_cifar100_rebuttal') if Path('/kaggle/working').exists() else Path('./bgm_cifar100_rebuttal')\nOUT_ROOT.mkdir(parents=True, exist_ok=True)\n\nif MODE == 'smoke':\n    CFG = dict(steps=20, batch_size=32, base_channels=32, samples=128, fid_images=128, nfe=8,\n               n_proxy=256, pca_dim=32, proxy_seeds=[0], compute_fid=False)\nelif MODE == 'pilot':\n    CFG = dict(steps=20000, batch_size=128, base_channels=64, samples=10000, fid_images=10000, nfe=64,\n               n_proxy=1024, pca_dim=64, proxy_seeds=[0,1,2], compute_fid=True)\nelif MODE == 'strong':\n    CFG = dict(steps=50000, batch_size=128, base_channels=96, samples=20000, fid_images=20000, nfe=64,\n               n_proxy=2048, pca_dim=64, proxy_seeds=[0,1,2], compute_fid=True)\nelse:\n    raise ValueError(MODE)\n\nCFG.update(dict(\n    lr=2e-4,\n    ema_decay=0.999,\n    save_every=1000,\n    max_minutes=None,  # set e.g. 650 on Kaggle if you want safe exit before runtime kill\n    sample_batch_size=256,\n    num_workers=2,\n    k_neighbors=32,\n    num_times=19,\n    t_min=0.05,\n    t_max=0.95,\n    ot_batch_size=128,\n    brownian_epsilon=0.5,\n))\nprint(json.dumps(CFG, indent=2))\nprint('OUT_ROOT =', OUT_ROOT)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-24T18:57:02.759971Z","iopub.execute_input":"2026-07-24T18:57:02.760685Z","iopub.status.idle":"2026-07-24T18:57:02.769078Z","shell.execute_reply.started":"2026-07-24T18:57:02.76066Z","shell.execute_reply":"2026-07-24T18:57:02.768242Z"}},"outputs":[{"name":"stdout","text":"{\n  \"steps\": 20000,\n  \"batch_size\": 128,\n  \"base_channels\": 64,\n  \"samples\": 10000,\n  \"fid_images\": 10000,\n  \"nfe\": 64,\n  \"n_proxy\": 1024,\n  \"pca_dim\": 64,\n  \"proxy_seeds\": [\n    0,\n    1,\n    2\n  ],\n  \"compute_fid\": true,\n  \"lr\": 0.0002,\n  \"ema_decay\": 0.999,\n  \"save_every\": 1000,\n  \"max_minutes\": null,\n  \"sample_batch_size\": 256,\n  \"num_workers\": 2,\n  \"k_neighbors\": 32,\n  \"num_times\": 19,\n  \"t_min\": 0.05,\n  \"t_max\": 0.95,\n  \"ot_batch_size\": 128,\n  \"brownian_epsilon\": 0.5\n}\nOUT_ROOT = /kaggle/working/bgm_cifar100_rebuttal\n","output_type":"stream"}],"execution_count":3},{"id":"f10454eb","cell_type":"markdown","source":"\n# Part A. Exact 3D Gaussian--OT diagnostic\n\nThis section computes \\(\\mathfrak G(\\mathscr Q,U,\\mathcal O)\\) exactly. Let \\(Y\\) stack all Gaussian variables, and suppose\n\\[\nU_t=A_tY,\\qquad S_t=B_tY.\n\\]\nThen\n\\[\ng(t)=\\operatorname{Tr}\\left[A_t\\Sigma_Y A_t^\\top - A_t\\Sigma_Y B_t^\\top(B_t\\Sigma_Y B_t^\\top)^{-1}B_t\\Sigma_Y A_t^\\top\\right].\n\\]\nNo kNN, no PCA, and no neural training are used.\n","metadata":{}},{"id":"d9f13498","cell_type":"code","source":"\ndef rotation_matrix_3d(seed=0):\n    rng = np.random.default_rng(seed)\n    Q, _ = np.linalg.qr(rng.normal(size=(3,3)))\n    if np.linalg.det(Q) < 0:\n        Q[:,0] *= -1\n    return Q\n\nR = rotation_matrix_3d(7)\neigs = np.array([4.0, 2.0, 1.5])\nSigma = R @ np.diag(eigs) @ R.T\nI3 = np.eye(3)\n\ndef sym_sqrt(M):\n    w, V = np.linalg.eigh((M + M.T)/2)\n    w = np.maximum(w, 0.0)\n    return V @ np.diag(np.sqrt(w)) @ V.T\n\nSigma_sqrt = sym_sqrt(Sigma)\n\n# Integration grid: state all exact values as truncated-window gap on [0.05,0.95]\nt_grid = np.linspace(CFG['t_min'], CFG['t_max'], 2001)\ndt_window = CFG['t_max'] - CFG['t_min']\n\ndef integrate_vals(vals):\n    return float(np.trapz(vals, t_grid))\n\n# Coupling covariance blocks for Y=[Z,X,eta]\ndef coupling_cov(coupling: str, sigma_noise: float=0.0):\n    # Cov(Z)=I, Cov(X)=Sigma, Cov(eta)=I for bridge noise.\n    if coupling == 'monge':\n        C = Sigma_sqrt  # Cov(Z, X)=Cov(Z, A Z)=A^T=A for symmetric A\n    elif coupling == 'independent':\n        C = np.zeros((3,3))\n    elif coupling == 'noisy_ot':\n        A = sym_sqrt(Sigma - sigma_noise**2 * I3)\n        C = A\n    else:\n        raise ValueError(coupling)\n    top = np.concatenate([I3, C, np.zeros((3,3))], axis=1)\n    mid = np.concatenate([C.T, Sigma, np.zeros((3,3))], axis=1)\n    bot = np.concatenate([np.zeros((3,3)), np.zeros((3,3)), I3], axis=1)\n    return np.concatenate([top, mid, bot], axis=0)\n\n# Linear maps U=A_t Y and state X_t = C_t Y.\ndef maps_for(bridge: str, t: float, eps: float=0.5):\n    # Y = [Z(3), X(3), eta(3)]\n    if bridge == 'straight':\n        Xt = np.concatenate([(1-t)*I3, t*I3, np.zeros((3,3))], axis=1)\n        U = np.concatenate([-I3, I3, np.zeros((3,3))], axis=1)  # X-Z\n    elif bridge == 'brownian':\n        noise_scale = math.sqrt(eps * t * (1-t))\n        Xt = np.concatenate([(1-t)*I3, t*I3, noise_scale*I3], axis=1)\n        # controlled drift toward endpoint for Brownian bridge: (X - X_t)/(1-t)\n        U = (np.concatenate([np.zeros((3,3)), I3, np.zeros((3,3))], axis=1) - Xt) / max(1e-8, (1-t))\n    else:\n        raise ValueError(bridge)\n    return U, Xt\n\ndef exact_gap(coupling: str, bridge: str, visible_dim: int=3, sigma_noise: float=0.0, eps: float=0.5):\n    CovY = coupling_cov(coupling, sigma_noise)\n    if visible_dim == 3:\n        P = np.eye(3)\n    elif visible_dim == 2:\n        P = np.array([[1,0,0],[0,1,0]], dtype=float)\n    elif visible_dim == 1:\n        P = np.array([[1,0,0]], dtype=float)\n    else:\n        raise ValueError(visible_dim)\n    gaps = []\n    vars_ = []\n    for t in t_grid:\n        A, Xt = maps_for(bridge, float(t), eps)\n        B = P @ Xt\n        SUU = A @ CovY @ A.T\n        SSS = B @ CovY @ B.T\n        SUS = A @ CovY @ B.T\n        # numerical pseudo-inverse for projected states\n        cond = SUU - SUS @ np.linalg.pinv(SSS) @ SUS.T\n        gaps.append(np.trace((cond + cond.T)/2))\n        vars_.append(np.trace((SUU + SUU.T)/2))\n    G = integrate_vals(np.array(gaps))\n    V = integrate_vals(np.array(vars_))\n    eta = G / V if V > 0 else np.nan\n    # endpoint cost E||X-Z||^2 for coupling\n    CovY2 = CovY[:6,:6]\n    L = np.concatenate([-I3, I3], axis=1)\n    endpoint_cost = float(np.trace(L @ CovY2 @ L.T))\n    return dict(exact_gap=G, velocity_variance=V, eta=eta, endpoint_cost=endpoint_cost)\n\nrows = []\nfor bridge in ['straight','brownian']:\n    for coupling, sig in [('monge',0.0), ('noisy_ot',0.3), ('noisy_ot',0.6), ('noisy_ot',1.0), ('independent',0.0)]:\n        if coupling == 'noisy_ot' and np.min(np.linalg.eigvalsh(Sigma - sig**2*I3)) < -1e-9:\n            continue\n        res = exact_gap(coupling, bridge, visible_dim=3, sigma_noise=sig, eps=CFG['brownian_epsilon'])\n        name = coupling if coupling != 'noisy_ot' else f'noisy OT sigma={sig}'\n        rows.append(dict(Bridge=bridge, Coupling=name, **res))\nexact_df = pd.DataFrame(rows)\nexact_df\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-24T18:57:02.770152Z","iopub.execute_input":"2026-07-24T18:57:02.770596Z","iopub.status.idle":"2026-07-24T18:57:04.539293Z","shell.execute_reply.started":"2026-07-24T18:57:02.77055Z","shell.execute_reply":"2026-07-24T18:57:04.538662Z"}},"outputs":[{"name":"stderr","text":"/tmp/ipykernel_58/482078885.py:25: DeprecationWarning: `trapz` is deprecated. Use `trapezoid` instead, or one of the numerical integration functions in `scipy.integrate`.\n  return float(np.trapz(vals, t_grid))\n","output_type":"stream"},{"execution_count":4,"output_type":"execute_result","data":{"text/plain":"     Bridge            Coupling     exact_gap  velocity_variance  \\\n0  straight               monge  5.794635e-15           1.099875   \n1  straight  noisy OT sigma=0.3  1.639033e-01           1.265699   \n2  straight  noisy OT sigma=0.6  6.740366e-01           1.788820   \n3  straight  noisy OT sigma=1.0  2.042734e+00           3.259516   \n4  straight         independent  6.735371e+00           9.450000   \n5  brownian               mon
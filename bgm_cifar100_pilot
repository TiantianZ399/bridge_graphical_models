    "transform = transforms.Compose([transforms.ToTensor(), ToMinusOneOne()])\n",
    "\n",
    "def get_torchvision_dataset(name='CIFAR100', train=True, root='/kaggle/working/data', download=True):\n",
    "    name_l = name.lower()\n",
    "    if name_l == 'cifar100':\n",
    "        return datasets.CIFAR100(root=root, train=train, transform=transform, download=download)\n",
    "    elif name_l == 'cifar10':\n",
    "        return datasets.CIFAR10(root=root, train=train, transform=transform, download=download)\n",

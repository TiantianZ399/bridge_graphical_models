    "@torch.no_grad()\n",
    "def collect_images(ds, n, seed=0, device='cpu'):\n",
    "    rng = np.random.default_rng(seed)\n",
    "    idx = rng.choice(len(ds), size=n, replace=False if n <= len(ds) else True)\n",
    "    xs = []\n",
    "    for i in idx:\n",
    "        x, _ = ds[int(i)]\n",
    "        xs.append(x)\n",
    "    return torch.stack(xs, 0).to(device)\n",
    "\n",
    "@torch.no_grad()\n",
    "def downsample_features(x, size=8):\n",
    "    return F.interpolate(x, size=(size,size), mode='area').flatten(1)\n",
    "\n",
    "def minibatch_ot_reorder(z_feat, x_feat, batch_size=128):\n",
    "    # z_feat, x_feat are numpy arrays of shape [n,d]\n",
    "    n = z_feat.shape[0]\n",
    "    order_z = []\n",
    "    order_x = []\n",
    "    for start in range(0, n, batch_size):\n",
    "        end = min(start + batch_size, n)\n",
    "        Zb = z_feat[start:end]\n",
    "        Xb = x_feat[start:end]\n",
    "        cost = ((Zb[:,None,:] - Xb[None,:,:])**2).sum(-1)\n",
    "        r, c = linear_sum_assignment(cost)\n",
    "        order_z.extend(start + r)\n",
    "        order_x.extend(start + c)\n",
    "    return np.array(order_z, dtype=np.int64), np.array(order_x, dtype=np.int64)\n",
    "\n",
    "@torch.no_grad()\n",
    "def proxy_gap_from_features(z_np, x_np, bridge='straight', k=32, num_times=19, t_min=0.05, t_max=0.95, eps=0.5, device=DEVICE):\n",
    "    z = torch.tensor(z_np, dtype=torch.float32, device=device)\n",
    "    x = torch.tensor(x_np, dtype=torch.float32, device=device)\n",
    "    n, d = z.shape\n",
    "    times = torch.linspace(t_min, t_max, num_times, device=device)\n",
    "    gaps = []\n",
    "    vars_ = []\n",
    "    for t in times:\n",
    "        if bridge == 'straight':\n",
    "            xt = (1-t) * z + t * x\n",
    "            u = x - z\n",
    "        elif bridge == 'brownian':\n",
    "            noise = torch.randn_like(z)\n",
    "            xt = (1-t) * z + t * x + math.sqrt(eps * float(t) * (1-float(t))) * noise\n",
    "            u = (x - xt) / max(1e-6, (1-float(t)))\n",
    "        else:\n",
    "            raise ValueError(bridge)\n",
    "        # brute-force cdist; n=1024 is fine on GPU.\n",
    "        dist = torch.cdist(xt, xt)\n",
    "        knn = torch.topk(dist, k=min(k+1,n), largest=False).indices[:,1:]\n",
    "        mean_u = u[knn].mean(dim=1)\n",
    "        gap_t = ((u - mean_u)**2).sum(dim=1).mean()\n",
    "        var_t = ((u - u.mean(dim=0, keepdim=True))**2).sum(dim=1).mean()\n",
    "        gaps.append(gap_t)\n",
    "        vars_.append(var_t)\n",
    "    gap = torch.stack(gaps).mean().item()\n",
    "    vel_var = torch.stack(vars_).mean().item()\n",
    "    eta = gap / vel_var if vel_var > 0 else float('nan')\n",
    "    endpoint_cost = ((x - z)**2).sum(dim=1).mean().item()\n",
    "    return dict(proxy_gap=gap, velocity_variance=vel_var, eta=eta, endpoint_cost=endpoint_cost, device=str(device))\n",
    "\n",
    "def estimate_dataset_proxy(dataset_name=DATASET_NAME, n=1024, pca_dim=64, seeds=(0,1,2), k=32, ot_batch=128, bridges=('straight','brownian')):\n",
    "    ds = get_torchvision_dataset(dataset_name, train=True)\n",
    "    out_rows = []\n",
    "    for seed in seeds:\n",
    "        set_seed(seed)\n",
    "        x_img = collect_images(ds, n=n, seed=seed, device=DEVICE)\n",
    "        z_img = torch.randn_like(x_img)\n",
    "        raw_feat = torch.cat([downsample_features(x_img), downsample_features(z_img)], dim=0).cpu().numpy()\n",
    "        # standardize before PCA\n",
    "        mu = raw_feat.mean(axis=0, keepdims=True)\n",
    "        sd = raw_feat.std(axis=0, keepdims=True) + 1e-6\n",
    "        raw_std = (raw_feat - mu) / sd\n",
    "        pca = PCA(n_components=min(pca_dim, raw_std.shape[1]), whiten=True, random_state=seed)\n",
    "        pca_feat = pca.fit_transform(raw_std)\n",
    "        x_pca = pca_feat[:n]\n",
    "        z_pca = pca_feat[n:]\n",
    "        # cost features for OT use standardized downsample features before PCA, to avoid PCA randomness in cost.\n",
    "        x_cost = raw_std[:n]\n",
    "        z_cost = raw_std[n:]\n",
    "        couplings = {}\n",
    "        couplings['independent'] = (np.arange(n), np.arange(n))\n",
    "        rz, rx = minibatch_ot_reorder(z_cost, x_cost, batch_size=ot_batch)\n",
    "        couplings['minibatch OT'] = (rz, rx)\n",
    "        for cname, (iz, ix) in couplings.items():\n",
    "            for bridge in bridges:\n",
    "                res = proxy_gap_from_features(z_pca[iz], x_pca[ix], bridge=bridge, k=k, num_times=CFG['num_times'],\n",
    "                                              t_min=CFG['t_min'], t_max=CFG['t_max'], eps=CFG['brownian_epsilon'], device=DEVICE)\n",
    "                out_rows.append(dict(dataset=dataset_name, seed=seed, coupling=cname, bridge=bridge, **res))\n",
    "                print(dataset_name, seed, bridge, cname, res)\n",
    "    df = pd.DataFrame(out_rows)\n",
    "    return df\n",
    "\n",
    "proxy_df = estimate_dataset_proxy(DATASET_NAME, n=CFG['n_proxy'], pca_dim=CFG['pca_dim'], seeds=CFG['proxy_seeds'],\n",
    "                                  k=CFG['k_neighbors'], ot_batch=CFG['ot_batch_size'], bridges=('straight','brownian'))\n",
    "proxy_df.to_csv(OUT_ROOT/f'{DATASET_NAME.lower()}_proxy_gap_by_seed.csv', index=False)\n",
    "proxy_summary = proxy_df.groupby(['dataset','bridge','coupling']).agg(\n",
    "    proxy_gap_mean=('proxy_gap','mean'), proxy_gap_std=('proxy_gap','std'),\n",
    "    eta_mean=('eta','mean'), eta_std=('eta','std'),\n",
    "    endpoint_cost_mean=('endpoint_cost','mean'), endpoint_cost_std=('endpoint_cost','std'),\n",
    "    velocity_variance_mean=('velocity_variance','mean'), velocity_variance_std=('velocity_variance','std'),\n",
    ").reset_index()\n",
    "proxy_summary.to_csv(OUT_ROOT/f'{DATASET_NAME.lower()}_proxy_gap_summary.csv', index=False)\n",
    "proxy_summary\n"

    "\n",
    "@torch.no_grad()\n",
    "def sample_model(model, ema, out_dir, n_samples=10000, batch_size=256, nfe=64):\n",
    "    out_dir = Path(out_dir); out_dir.mkdir(parents=True, exist_ok=True)\n",
    "    # Use EMA weights for sampling.\n",
    "    model_ema = SmallUNet(base=CFG['base_channels']).to(DEVICE)\n",
    "    model_ema.load_state_dict(model.state_dict())\n",
    "    ema.copy_to(model_ema)\n",
    "    model_ema.eval()\n",
    "    count = 0\n",
    "    dt = 1.0 / nfe\n",
    "    pbar = tqdm(total=n_samples, desc='sampling')\n",
    "    while count < n_samples:\n",
    "        B = min(batch_size, n_samples-count)\n",
    "        y = torch.randn(B, 3, 32, 32, device=DEVICE)\n",
    "        for i in range(nfe):\n",
    "            t = torch.full((B,), i / nfe, device=DEVICE)\n",
    "            y = y + dt * model_ema(y, t)\n",
    "        y = y.clamp(-1,1)\n",
    "        save_tensor_images(y, out_dir, start_idx=count)\n",
    "        count += B\n",
    "        pbar.update(B)\n",
    "    pbar.close()\n",
    "\n",
    "def save_tensor_images(x, out_dir, start_idx=0):\n",
    "    out_dir = Path(out_dir); out_dir.mkdir(parents=True, exist_ok=True)\n",
    "    x = ((x.detach().cpu().clamp(-1,1) + 1) * 127.5).to(torch.uint8)\n",
    "    for i in range(x.shape[0]):\n",
    "        arr = x[i].permute(1,2,0).numpy()\n",
    "        Image.fromarray(arr).save(out_dir/f'{start_idx+i:06d}.png')\n",
    "\n",
    "def save_reference_images(ds, out_dir, n_images=10000):\n",
    "    out_dir = Path(out_dir); out_dir.mkdir(parents=True, exist_ok=True)\n",
    "    loader = DataLoader(ds, batch_size=256, shuffle=False, num_workers=CFG['num_workers'])\n",
    "    count = 0\n",
    "    for x,_ in loader:\n",
    "        B = min(x.shape[0], n_images-count)\n",
    "        save_tensor_images(x[:B], out_dir, start_idx=count)\n",
    "        count += B\n",
    "        if count >= n_images: break\n",
    "\n",
    "def compute_fidelity(generated_dir, reference_dir, cuda=True):\n",
    "    try:\n",
    "        from torch_fidelity import calculate_metrics\n",
    "        metrics = calculate_metrics(\n",
    "            input1=str(generated_dir), input2=str(reference_dir),\n",
    "            cuda=bool(cuda and torch.cuda.is_available()), isc=True, fid=True, kid=True,\n",
    "            kid_subset_size=min(1000, len(list(Path(generated_dir).glob('*.png')))),\n",
    "            kid_subsets=10, verbose=True, save_cpu_ram=True, samples_find_deep=False,\n",
    "            dataloader_num_workers=CFG['num_workers']\n",
    "        )\n",
    "        return metrics\n",
    "    except Exception as e:\n",
    "        print('torch-fidelity failed:', repr(e))\n",
    "        return {}\n"
   ]

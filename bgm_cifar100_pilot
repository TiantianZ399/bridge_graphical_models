    "def infinite_loader(loader):\n",
    "    while True:\n",
    "        for batch in loader:\n",
    "            yield batch\n",
    "\n",
    "@torch.no_grad()\n",
    "def pair_batch(x, coupling='independent', ot_batch_size=128):\n",
    "    z = torch.randn_like(x)\n",
    "    if coupling == 'independent':\n",
    "        return z, x\n",
    "    if coupling != 'minibatch OT':\n",
    "        raise ValueError(coupling)\n",
    "    B = x.shape[0]\n",
    "    z_out = []\n",
    "    x_out = []\n",
    "    for start in range(0, B, ot_batch_size):\n",
    "        end = min(start+ot_batch_size, B)\n",
    "        xb = x[start:end]\n",
    "        zb = z[start:end]\n",
    "        xf = F.interpolate(xb, size=(8,8), mode='area').flatten(1).cpu().numpy()\n",
    "        zf = F.interpolate(zb, size=(8,8), mode='area').flatten(1).cpu().numpy()\n",
    "        cost = ((zf[:,None,:] - xf[None,:,:])**2).sum(-1)\n",
    "        r, c = linear_sum_assignment(cost)\n",
    "        z_out.append(zb[torch.as_tensor(r, device=DEVICE)])\n",
    "        x_out.append(xb[torch.as_tensor(c, device=DEVICE)])\n",
    "    return torch.cat(z_out, dim=0), torch.cat(x_out, dim=0)\n",
    "\n",
    "def save_checkpoint(path, model, opt, ema, step, losses, config):\n",
    "    path.parent.mkdir(parents=True, exist_ok=True)\n",
    "    torch.save({'model':model.state_dict(), 'opt':opt.state_dict(), 'ema':ema.shadow, 'step':step, 'losses':losses, 'config':config}, path)\n",
    "\n",
    "def load_checkpoint(path, model, opt=None, ema=None):\n",
    "    ckpt = torch.load(path, map_location=DEVICE)\n",
    "    model.load_state_dict(ckpt['model'])\n",
    "    if opt is not None and 'opt' in ckpt:\n",
    "        opt.load_state_dict(ckpt['opt'])\n",
    "    if ema is not None and 'ema' in ckpt:\n",
    "        ema.shadow = ckpt['ema']\n",
    "    return ckpt.get('step',0), ckpt.get('losses',[])\n",
    "\n",
    "def train_one_coupling(coupling, out_dir, resume=True):\n",
    "    out_dir = Path(out_dir); out_dir.mkdir(parents=True, exist_ok=True)\n",
    "    set_seed(123 if coupling=='independent' else 456)\n",
    "    loader = DataLoader(train_ds, batch_size=CFG['batch_size'], shuffle=True, drop_last=True,\n",
    "                        num_workers=CFG['num_workers'], pin_memory=True)\n",
    "    it = infinite_loader(loader)\n",
    "    model = SmallUNet(base=CFG['base_channels']).to(DEVICE)\n",
    "    opt = torch.optim.AdamW(model.parameters(), lr=CFG['lr'], weight_decay=1e-4)\n",
    "    ema = EMA(model, decay=CFG['ema_decay'])\n",
    "    start_step, losses = 0, []\n",
    "    ckpt_path = out_dir/'checkpoint_latest.pt'\n",
    "    if resume and ckpt_path.exists():\n",
    "        start_step, losses = load_checkpoint(ckpt_path, model, opt, ema)\n",
    "        print('Resumed', coupling, 'from step', start_step)\n",
    "    t0 = time.time()\n",
    "    for step in range(start_step+1, CFG['steps']+1):\n",
    "        x, _ = next(it)\n",
    "        x = x.to(DEVICE, non_blocking=True)\n",
    "        z, x = pair_batch(x, coupling=coupling, ot_batch_size=CFG['ot_batch_size'])\n",
    "        B = x.shape[0]\n",
    "        t = torch.rand(B, device=DEVICE) * (CFG['t_max']-CFG['t_min']) + CFG['t_min']\n",
    "        tv = t[:,None,None,None]\n",
    "        xt = (1-tv)*z + tv*x\n",
    "        target = x - z\n",
    "        pred = model(xt, t)\n",
    "        loss = F.mse_loss(pred, target)\n",
    "        opt.zero_grad(set_to_none=True)\n",
    "        loss.backward()\n",
    "        torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n",
    "        opt.step()\n",
    "        ema.update(model)\n",
    "        losses.append(float(loss.item()))\n",
    "        if step == 1 or step % 1000 == 0:\n",
    "            elapsed = (time.time()-t0)/60\n",
    "            print(f'{coupling} step={step:05d}/{CFG[\"steps\"]} loss={loss.item():.6f} elapsed={elapsed:.1f}m')\n",
    "        if step % CFG['save_every'] == 0 or step == CFG['steps']:\n",
    "            save_checkpoint(ckpt_path, model, opt, ema, step, losses, CFG)\n",
    "        if CFG.get('max_minutes') and (time.time()-t0)/60 > CFG['max_minutes']:\n",
    "            save_checkpoint(ckpt_path, model, opt, ema, step, losses, CFG)\n",
    "            print('Reached max_minutes; saved checkpoint and exiting training loop.')\n",
    "            break\n",
    "    # Save history\n",
    "    pd.DataFrame({'step':np.arange(1,len(losses)+1), 'loss':losses}).to_csv(out_dir/'training_loss.csv', index=False)\n",
    "    summary = {'dataset':DATASET_NAME, 'coupling':coupling, 'last_step':start_step + (len(losses)-len(losses[:start_step]) if False else 0),\n",
    "               'steps_requested':CFG['steps'], 'final_loss':float(losses[-1]),\n",
    "               'mean_last_100_loss':float(np.mean(losses[-100:])), 'config':CFG}\n",
    "    with open(out_dir/'summary_train.json','w') as f: json.dump(summary, f, indent=2)\n",
    "    return model, ema, losses\n"
   ]

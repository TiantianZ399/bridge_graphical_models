ecated. Use `trapezoid` instead, or one of the numerical integration functions in `scipy.integrate`.\n  return float(np.trapz(vals, t_grid))\n","output_type":"stream"},{"execution_count":6,"output_type":"execute_result","data":{"text/plain":"             Configuration     exact_gap  velocity_variance           eta  \\\n0     straight, full state  5.794635e-15           1.099875  5.268450e-15   \n1  straight, 2D projection  1.504200e-01           1.099875  1.367610e-01   \n2  straight, 1D projection  1.048140e+00           1.099875  9.529631e-01   \n3     Brownian, full state  3.493841e+00           4.166543  8.385466e-01   \n\n   endpoint_cost  \n0       1.222083  \n1       1.222083  \n2       1.222083  \n3       1.222083  ","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>Configuration</th>\n      <th>exact_gap</th>\n      <th>velocity_variance</th>\n      <th>eta</th>\n      <th>endpoint_cost</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>straight, full state</td>\n      <td>5.794635e-15</td>\n      <td>1.099875</td>\n      <td>5.268450e-15</td>\n      <td>1.222083</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>straight, 2D projection</td>\n      <td>1.504200e-01</td>\n      <td>1.099875</td>\n      <td>1.367610e-01</td>\n      <td>1.222083</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>straight, 1D projection</td>\n      <td>1.048140e+00</td>\n      <td>1.099875</td>\n      <td>9.529631e-01</td>\n      <td>1.222083</td>\n    </tr>\n    <tr>\n      <th>3</th>\n      <td>Brownian, full state</td>\n      <td>3.493841e+00</td>\n      <td>4.166543</td>\n      <td>8.385466e-01</td>\n      <td>1.222083</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":6},{"id":"25885afe","cell_type":"code","source":"\ndef fmt_pm(x, digits=3):\n    return f'{x:.{digits}f}'\n\nOUT_ROOT.mkdir(exist_ok=True, parents=True)\nexact_df.to_csv(OUT_ROOT/'exact_3d_gaussian_ot_gap.csv', index=False)\nvisible_df.to_csv(OUT_ROOT/'visible_state_ablation.csv', index=False)\ncontrol_df.to_csv(OUT_ROOT/'gap_vs_energy_controls.csv', index=False)\n\n# LaTeX snippets.\nlatex_exact = exact_df.copy()\nfor c in ['endpoint_cost','exact_gap','velocity_variance','eta']:\n    latex_exact[c] = latex_exact[c].map(lambda x: f'{x:.3f}')\nwith open(OUT_ROOT/'table_exact_3d_gaussian_ot.tex', 'w') as f:\n    f.write(latex_exact.to_latex(index=False, escape=False))\n\nlatex_visible = visible_df.copy()\nfor c in ['endpoint_cost','exact_gap','velocity_variance','eta']:\n    latex_visible[c] = latex_visible[c].map(lambda x: f'{x:.3f}')\nwith open(OUT_ROOT/'table_visible_state_ablation.tex', 'w') as f:\n    f.write(latex_visible.to_latex(index=False, escape=False))\n\nprint('Saved exact 3D tables to', OUT_ROOT)\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"a4e8c7ae","cell_type":"markdown","source":"\n# Part B. CIFAR-100 larger-dataset pilot\n\nCIFAR-100 is a larger and more diverse dataset than CIFAR-10 while keeping the image size at 32x32, so it is still feasible in a few GPU hours.\n\nWe use it to test the narrow empirical claim:\n\n> within a fixed straight-bridge pixel-space flow-matching setup, the pre-training feature-space proxy gap ranks coupling choices in the same direction as downstream training loss and FID/KID.\n\nThe proxy gap is not treated as a certified pixel-space population lower bound.\n","metadata":{}},{"id":"2f1adb22","cell_type":"code","source":"\ndef set_seed(seed: int):\n    random.seed(seed)\n    np.random.seed(seed)\n    torch.manual_seed(seed)\n    torch.cuda.manual_seed_all(seed)\n\nclass ToMinusOneOne:\n    def __call__(self, x):\n        return x * 2.0 - 1.0\n\ntransform = transforms.Compose([transforms.ToTensor(), ToMinusOneOne()])\n\ndef get_torchvision_dataset(name='CIFAR100', train=True, root='/kaggle/working/data', download=True):\n    name_l = name.lower()\n    if name_l == 'cifar100':\n        return datasets.CIFAR100(root=root, train=train, transform=transform, download=download)\n    elif name_l == 'cifar10':\n        return datasets.CIFAR10(root=root, train=train, transform=transform, download=download)\n    elif name_l == 'fashionmnist':\n        # convert grayscale to 3 channels to reuse model/fidelity pipeline\n        tfm = transforms.Compose([transforms.Grayscale(num_output_channels=3), transforms.ToTensor(), ToMinusOneOne()])\n        return datasets.FashionMNIST(root=root, train=train, transform=tfm, download=download)\n    else:\n        raise ValueError(name)\n\ntrain_ds = get_torchvision_dataset(DATASET_NAME, train=True)\ntest_ds = get_torchvision_dataset(DATASET_NAME, train=False)\nprint(DATASET_NAME, len(train_ds), len(test_ds))\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"b1138618","cell_type":"markdown","source":"\n## Feature-space proxy gap estimator\n\nThis estimator uses downsampled image features followed by PCA. It reports both raw proxy gap and energy baselines. The normalized ratio \\(\\eta\\) is included for diagnosis only; it should not be oversold. In image experiments, \\(\\eta\\) can reveal whether a raw proxy-gap decrease is mainly due to lower velocity scale.\n","metadata":{}},{"id":"6d332dee","cell_type":"code","source":"\n@torch.no_grad()\ndef collect_images(ds, n, seed=0, device='cpu'):\n    rng = np.random.default_rng(seed)\n    idx = rng.choice(len(ds), size=n, replace=False if n <= len(ds) else True)\n    xs = []\n    for i in idx:\n        x, _ = ds[int(i)]\n        xs.append(x)\n    return torch.stack(xs, 0).to(device)\n\n@torch.no_grad()\ndef downsample_features(x, size=8):\n    return F.interpolate(x, size=(size,size), mode='area').flatten(1)\n\ndef minibatch_ot_reorder(z_feat, x_feat, batch_size=128):\n    # z_feat, x_feat are numpy arrays of shape [n,d]\n    n = z_feat.shape[0]\n    order_z = []\n    order_x = []\n    for start in range(0, n, batch_size):\n        end = min(start + batch_size, n)\n        Zb = z_feat[start:end]\n        Xb = x_feat[start:end]\n        cost = ((Zb[:,None,:] - Xb[None,:,:])**2).sum(-1)\n        r, c = linear_sum_assignment(cost)\n        order_z.extend(start + r)\n        order_x.extend(start + c)\n    return np.array(order_z, dtype=np.int64), np.array(order_x, dtype=np.int64)\n\n@torch.no_grad()\ndef proxy_gap_from_features(z_np, x_np, bridge='straight', k=32, num_times=19, t_min=0.05, t_max=0.95, eps=0.5, device=DEVICE):\n    z = torch.tensor(z_np, dtype=torch.float32, device=device)\n    x = torch.tensor(x_np, dtype=torch.float32, device=device)\n    n, d = z.shape\n    times = torch.linspace(t_min, t_max, num_times, device=device)\n    gaps = []\n    vars_ = []\n    for t in times:\n        if bridge == 'straight':\n            xt = (1-t) * z + t * x\n            u = x - z\n        elif bridge == 'brownian':\n            noise = torch.randn_like(z)\n            xt = (1-t) * z + t * x + math.sqrt(eps * float(t) * (1-float(t))) * noise\n            u = (x - xt) / max(1e-6, (1-float(t)))\n        else:\n            raise ValueError(bridge)\n        # brute-force cdist; n=1024 is fine on GPU.\n        dist = torch.cdist(xt, xt)\n        knn = torch.topk(dist, k=min(k+1,n), largest=False).indices[:,1:]\n        mean_u = u[knn].mean(dim=1)\n        gap_t = ((u - mean_u)**2).sum(dim=1).mean()\n        var_t = ((u - u.mean(dim=0, keepdim=True))**2).sum(dim=1).mean()\n        gaps.append(gap_t)\n        vars_.append(var_t)\n    gap = torch.stack(gaps).mean().item()\n    vel_var = torch.stack(vars_).mean().item()\n    eta = gap / vel_var if vel_var > 0 else float('nan')\n    endpoint_cost = ((x - z)**2).sum(dim=1).mean().item()\n    return dict(proxy_gap=gap, velocity_variance=vel_var, eta=eta, endpoint_cost=endpoint_cost, device=str(device))\n\ndef estimate_dataset_proxy(dataset_name=DATASET_NAME, n=1024, pca_dim=64, seeds=(0,1,2), k=32, ot_batch=128, bridges=('straight','brownian')):\n    ds = get_torchvision_dataset(dataset_name, train=True)\n    out_rows = []\n    for seed in seeds:\n        set_seed(seed)\n        x_img = collect_images(ds, n=n, seed=seed, device=DEVICE)\n        z_img = torch.randn_like(x_img)\n        raw_feat = torch.cat([downsample_features(x_img), downsample_features(z_img)], dim=0).cpu().numpy()\n        # standardize before PCA\n        mu = raw_feat.mean(axis=0, keepdims=True)\n        sd = raw_feat.std(axis=0, keepdims=True) + 1e-6\n        raw_std = (raw_feat - mu) / sd\n        pca = PCA(n_components=min(pca_dim, raw_std.shape[1]), whiten=True, random_state=seed)\n        pca_feat = pca.fit_transform(raw_std)\n        x_pca = pca_feat[:n]\n        z_pca = pca_feat[n:]\n        # cost features for OT use standardized downsample features before PCA, to avoid PCA randomness in cost.\n        x_cost = raw_std[:n]\n        z_cost = raw_std[n:]\n        couplings = {}\n        couplings['independent'] = (np.arange(n), np.arange(n))\n        rz, rx = minibatch_ot_reorder(z_cost, x_cost, batch_size=ot_batch)\n        couplings['minibatch OT'] = (rz, rx)\n        for cname, (iz, ix) in couplings.items():\n            for bridge in bridges:\n                res = proxy_gap_from_features(z_pca[iz], x_pca[ix], bridge=bridge, k=k, num_times=CFG['num_times'],\n                                              t_min=CFG['t_min'], t_max=CFG['t_max'], eps=CFG['brownian_epsilon'], device=DEVICE)\n                out_rows.append(dict(dataset=dataset_name, seed=seed, coupling=cname, bridge=bridge, **res))\n                print(dataset_name, seed, bridge, cname, res)\n    df = pd.DataFrame(out_rows)\n    return df\n\nproxy_df = estimate_dataset_proxy(DATASET_NAME, n=CFG['n_proxy'], pca_dim=CFG['pca_dim'], seeds=CFG['proxy_seeds'],\n                                  k=CFG['k_neighbors'], ot_batch=CFG['ot_batch_size'], bridges=('straight','brownian'))\nproxy_df.to_csv(OUT_ROOT/f'{DATASET_NAME.lower()}_proxy_gap_by_seed.csv', index=False)\nproxy_summary = proxy_df.groupby(['dataset','bridge','coupling']).agg(\n    proxy_gap_mean=('proxy_gap','mean'), proxy_gap_std=('proxy_gap','std'),\n    eta_mean=('eta','mean'), eta_std=('eta','std'),\n    endpoint_cost_mean=('endpoint_cost','mean'), endpoint_cost_std=('endpoint_cost','std'),\n    velocity_variance_mean=('velocity_variance','mean'), velocity_variance_std=('velocity_variance','std'),\n).reset_index()\nproxy_summary.to_csv(OUT_ROOT/f'{DATASET_NAME.lower()}_proxy_gap_summary.csv', index=False)\nproxy_summary\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"18c7bbd8","cell_type":"markdown","source":"\n## Pixel-space flow matching model\n","metadata":{}},{"id":"daa97187","cell_type":"code","source":"\nclass SinusoidalPosEmb(nn.Module):\n    def __init__(self, dim):\n        super().__init__()\n        self.dim = dim\n    def forward(self, t):\n        if t.ndim > 1:\n            t = t.view(t.shape[0])\n        half = self.dim // 2\n        freqs = torch.exp(torch.arange(half, device=t.device) * -(math.log(10000) / max(half-1,1)))\n        args = t[:, None] * freqs[None, :]\n        emb = torch.cat([args.sin(), args.cos()], dim=-1)\n        if self.dim % 2:\n            emb = F.pad(emb, (0,1))\n        return emb\n\nclass ResBlock(nn.Module):\n    def __init__(self, in_ch, out_ch, time_dim):\n        super().__init__()\n        self.norm1 = nn.GroupNorm(8, in_ch)\n        self.conv1 = nn.Conv2d(in_ch, out_ch, 3, padding=1)\n        self.time = nn.Linear(time_dim, out_ch)\n        self.norm2 = nn.GroupNorm(8, out_ch)\n        self.conv2 = nn.Conv2d(out_ch, out_ch, 3, padding=1)\n        self.skip = nn.Conv2d(in_ch, out_ch, 1) if in_ch != out_ch else nn.Identity()\n    def forward(self, x, temb):\n        h = self.conv1(F.silu(self.norm1(x)))\n        h = h + self.time(F.silu(temb))[:, :, None, None]\n        h = self.conv2(F.silu(self.norm2(h)))\n        return h + self.skip(x)\n\nclass SmallUNet(nn.Module):\n    def __init__(self, in_ch=3, base=64, time_dim=256):\n        super().__init__()\n        self.time_mlp = nn.Sequential(SinusoidalPosEmb(time_dim), nn.Linear(time_dim, time_dim), nn.SiLU(), nn.Linear(time_dim, time_dim))\n        self.in_conv = nn.Conv2d(in_ch, base, 3, padding=1)\n        self.rb1 = ResBlock(base, base, time_dim)\n        self.down1 = nn.Conv2d(base, base*2, 4, stride=2, padding=1)\n        self.rb2 = ResBlock(base*2, base*2, time_dim)\n        self.down2 = nn.Conv2d(base*2, base*4, 4, stride=2, padding=1)\n        self.rb3 = ResBlock(base*4, base*4, time_dim)\n        self.mid = ResBlock(base*4, base*4, time_dim)\n        self.up2 = nn.ConvTranspose2d(base*4, base*2, 4, stride=2, padding=1)\n        self.rb4 = ResBlock(base*4, base*2, time_dim)\n        self.up1 = nn.ConvTranspose2d(base*2, base, 4, stride=2, padding=1)\n        self.rb5 = ResBlock(base*2, base, time_dim)\n        self.out_norm = nn.GroupNorm(8, base)\n        self.out = nn.Conv2d(base, in_ch, 3, padding=1)\n    def forward(self, x, t):\n        temb = self.time_mlp(t)\n        x0 = self.in_conv(x)\n        h1 = self.rb1(x0, temb)\n        h2 = self.rb2(self.down1(h1), temb)\n        h3 = self.rb3(self.down2(h2), temb)\n        h = self.mid(h3, temb)\n        h = self.up2(h)\n        h = self.rb4(torch.cat([h, h2], dim=1), temb)\n        h = self.up1(h)\n        h = self.rb5(torch.cat([h, h1], dim=1), temb)\n        return self.out(F.silu(self.out_norm(h)))\n\nclass EMA:\n    def __init__(self, model, decay=0.999):\n        self.decay = decay\n        self.shadow = {k: v.detach().clone() for k,v in model.state_dict().items() if v.dtype.is_floating_point}\n    @torch.no_grad()\n    def update(self, model):\n        for k,v in model.state_dict().items():\n            if k in self.shadow:\n                self.shadow[k].mul_(self.decay).add_(v.detach(), alpha=1-self.decay)\n    def copy_to(self, model):\n        sd = model.state_dict()\n        for k,v in self.shadow.items():\n            sd[k].copy_(v)\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"e9117bde","cell_type":"code","source":"\ndef infinite_loader(loader):\n    while True:\n        for batch in loader:\n            yield batch\n\n@torch.no_grad()\ndef pair_batch(x, coupling='independent', ot_batch_size=128):\n    z = torch.randn_like(x)\n    if coupling == 'independent':\n        return z, x\n    if coupling != 'minibatch OT':\n        raise ValueError(coupling)\n    B = x.shape[0]\n    z_out = []\n    x_out = []\n    for start in range(0, B, ot_batch_size):\n        end = min(start+ot_batch_size, B)\n        xb = x[start:end]\n        zb = z[start:end]\n        xf = F.interpolate(xb, size=(8,8), mode='area').flatten(1).cpu().numpy()\n        zf = F.interpolate(zb, size=(8,8), mode='area').flatten(1).cpu().numpy()\n        cost = ((zf[:,None,:] - xf[None,:,:])**2).sum(-1)\n        r, c = linear_sum_assignment(cost)\n        z_out.append(zb[torch.as_tensor(r, device=DEVICE)])\n        x_out.append(xb[torch.as_tensor(c, device=DEVICE)])\n    return torch.cat(z_out, dim=0), torch.cat(x_out, dim=0)\n\ndef save_checkpoint(path, model, opt, ema, step, losses, config):\n    path.parent.mkdir(parents=True, exist_ok=True)\n    torch.save({'model':model.state_dict(), 'opt':opt.state_dict(), 'ema':ema.shadow, 'step':step, 'losses':losses, 'config':config}, path)\n\ndef load_checkpoint(path, model, opt=None, ema=None):\n    ckpt = torch.load(path, map_location=DEVICE)\n    model.load_state_dict(ckpt['model'])\n    if opt is not None and 'opt' in ckpt:\n        opt.load_state_dict(ckpt['opt'])\n    if ema is not None and 'ema' in ckpt:\n        ema.shadow = ckpt['ema']\n    return ckpt.get('step',0), ckpt.get('losses',[])\n\ndef train_one_co
    "\n",
    "# Generate compact LaTeX table snippets.\n",
    "def pm(mean, sd, nd=2):\n",
    "    if pd.isna(sd): return f'{mean:.{nd}f}'\n",
    "    return f'${mean:.{nd}f}\\\\pm{sd:.{nd}f}$'\n",
    "\n",
    "lines = []\n",
    "lines.append(r'\\begin{table}[t]')\n",
    "lines.append(r'\\centering\\small')\n",
    "lines.append(r'\\caption{CIFAR-100 larger-dataset pilot. The proxy gap is estimated before training in a fixed feature space and used only for within-dataset ranking. Downstream rows use the same straight bridge, architecture, sampler, and compute.}')\n",
    "lines.append(r'\\label{tab:cifar100_pilot}')\n",
    "lines.append(r'\\begin{tabular}{@{}lccccc@{}}')\n",
    "lines.append(r'\\toprule')\n",
    "lines.append(r'Coupling & Proxy gap $\\downarrow$ & Endpoint cost & Train loss $\\downarrow$ & FID $\\downarrow$ & KID $\\downarrow$ \\\\')\n",
    "lines.append(r'\\midrule')\n",
    "for _, r in merged.iterrows():\n",
    "    lines.append(f\"{r['coupling']} & {pm(r['proxy_gap_mean'], r['proxy_gap_std'], 2)} & {r['endpoint_cost_mean']:.2f} & {r['train_loss']:.4f} & {r['fid']:.2f} & {r['kid']:.4f} \\\\\")\n",
    "lines.append(r'\\bottomrule')\n",
    "lines.append(r'\\end{tabular}')\n",
    "lines.append(r'\\end{table}')\n",
    "latex = '\\n'.join(lines)\n",
    "print(latex)\n",
    "with open(OUT_ROOT/'table_cifar100_pilot.tex','w') as f: f.write(latex)\n",
    "\n",
    "# Exact 3D rebuttal paragraph.\n",
    "paragraph = r'''\n",
    "To address concerns about proxy estimation and transport-cost confounding, we add an exact 3D Gaussian--OT diagnostic. In this setting the Markovization gap is computed analytically from Gaussian conditional covariances rather than from a kNN/PCA proxy. The experiment varies the endpoint coupling, bridge law, and sampler-visible state. A straight Monge-OT bridge has zero gap with the full state because the current state identifies the endpoint pairing. Adding coupling noise or using independent coupling gives positive gap. With the same Monge endpoint coupling and endpoint cost, a Brownian bridge has positive gap, and projecting the same straight bridge to a lower-dimensional visible state also creates positive gap. Thus the gap is not determined solely by endpoint transport cost or velocity energy; it depends on the triple $(\\mathscr Q,U,\\mathcal O)$.\n",
    "'''\n",
    "with open(OUT_ROOT/'rebuttal_exact3d_paragraph.tex','w') as f: f.write(paragraph)\n",
    "print('\\nSaved outputs to', OUT_ROOT)\n"

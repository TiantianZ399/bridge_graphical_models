    "\n",
    "def rotation_matrix_3d(seed=0):\n",
    "    rng = np.random.default_rng(seed)\n",
    "    Q, _ = np.linalg.qr(rng.normal(size=(3,3)))\n",
    "    if np.linalg.det(Q) < 0:\n",
    "        Q[:,0] *= -1\n",
    "    return Q\n",
    "\n",
    "R = rotation_matrix_3d(7)\n",
    "eigs = np.array([4.0, 2.0, 1.5])\n",
    "Sigma = R @ np.diag(eigs) @ R.T\n",
    "I3 = np.eye(3)\n",
    "\n",
    "def sym_sqrt(M):\n",
    "    w, V = np.linalg.eigh((M + M.T)/2)\n",
    "    w = np.maximum(w, 0.0)\n",
    "    return V @ np.diag(np.sqrt(w)) @ V.T\n",
    "\n",
    "Sigma_sqrt = sym_sqrt(Sigma)\n",
    "\n",
    "# Integration grid: state all exact values as truncated-window gap on [0.05,0.95]\n",
    "t_grid = np.linspace(CFG['t_min'], CFG['t_max'], 2001)\n",
    "dt_window = CFG['t_max'] - CFG['t_min']\n",
    "\n",
    "def integrate_vals(vals):\n",
    "    return float(np.trapz(vals, t_grid))\n",
    "\n",
    "# Coupling covariance blocks for Y=[Z,X,eta]\n",
    "def coupling_cov(coupling: str, sigma_noise: float=0.0):\n",
    "    # Cov(Z)=I, Cov(X)=Sigma, Cov(eta)=I for bridge noise.\n",
    "    if coupling == 'monge':\n",
    "        C = Sigma_sqrt  # Cov(Z, X)=Cov(Z, A Z)=A^T=A for symmetric A\n",
    "    elif coupling == 'independent':\n",
    "        C = np.zeros((3,3))\n",
    "    elif coupling == 'noisy_ot':\n",
    "        A = sym_sqrt(Sigma - sigma_noise**2 * I3)\n",
    "        C = A\n",
    "    else:\n",
    "        raise ValueError(coupling)\n",
    "    top = np.concatenate([I3, C, np.zeros((3,3))], axis=1)\n",
    "    mid = np.concatenate([C.T, Sigma, np.zeros((3,3))], axis=1)\n",
    "    bot = np.concatenate([np.zeros((3,3)), np.zeros((3,3)), I3], axis=1)\n",
    "    return np.concatenate([top, mid, bot], axis=0)\n",
    "\n",
    "# Linear maps U=A_t Y and state X_t = C_t Y.\n",
    "def maps_for(bridge: str, t: float, eps: float=0.5):\n",
    "    # Y = [Z(3), X(3), eta(3)]\n",
    "    if bridge == 'straight':\n",
    "        Xt = np.concatenate([(1-t)*I3, t*I3, np.zeros((3,3))], axis=1)\n",
    "        U = np.concatenate([-I3, I3, np.zeros((3,3))], axis=1)  # X-Z\n",
    "    elif bridge == 'brownian':\n",
    "        noise_scale = math.sqrt(eps * t * (1-t))\n",
    "        Xt = np.concatenate([(1-t)*I3, t*I3, noise_scale*I3], axis=1)\n",
    "        # controlled drift toward endpoint for Brownian bridge: (X - X_t)/(1-t)\n",
    "        U = (np.concatenate([np.zeros((3,3)), I3, np.zeros((3,3))], axis=1) - Xt) / max(1e-8, (1-t))\n",
    "    else:\n",
    "        raise ValueError(bridge)\n",
    "    return U, Xt\n",
    "\n",
    "def exact_gap(coupling: str, bridge: str, visible_dim: int=3, sigma_noise: float=0.0, eps: float=0.5):\n",
    "    CovY = coupling_cov(coupling, sigma_noise)\n",
    "    if visible_dim == 3:\n",
    "        P = np.eye(3)\n",
    "    elif visible_dim == 2:\n",
    "        P = np.array([[1,0,0],[0,1,0]], dtype=float)\n",
    "    elif visible_dim == 1:\n",
    "        P = np.array([[1,0,0]], dtype=float)\n",
    "    else:\n",
    "        raise ValueError(visible_dim)\n",
    "    gaps = []\n",
    "    vars_ = []\n",
    "    for t in t_grid:\n",
    "        A, Xt = maps_for(bridge, float(t), eps)\n",
    "        B = P @ Xt\n",
    "        SUU = A @ CovY @ A.T\n",
    "        SSS = B @ CovY @ B.T\n",
    "        SUS = A @ CovY @ B.T\n",
    "        # numerical pseudo-inverse for projected states\n",
    "        cond = SUU - SUS @ np.linalg.pinv(SSS) @ SUS.T\n",
    "        gaps.append(np.trace((cond + cond.T)/2))\n",
    "        vars_.append(np.trace((SUU + SUU.T)/2))\n",
    "    G = integrate_vals(np.array(gaps))\n",
    "    V = integrate_vals(np.array(vars_))\n",
    "    eta = G / V if V > 0 else np.nan\n",
    "    # endpoint cost E||X-Z||^2 for coupling\n",
    "    CovY2 = CovY[:6,:6]\n",
    "    L = np.concatenate([-I3, I3], axis=1)\n",
    "    endpoint_cost = float(np.trace(L @ CovY2 @ L.T))\n",
    "    return dict(exact_gap=G, velocity_variance=V, eta=eta, endpoint_cost=endpoint_cost)\n",
    "\n",
    "rows = []\n",
    "for bridge in ['straight','brownian']:\n",
    "    for coupling, sig in [('monge',0.0), ('noisy_ot',0.3), ('noisy_ot',0.6), ('noisy_ot',1.0), ('independent',0.0)]:\n",
    "        if coupling == 'noisy_ot' and np.min(np.linalg.eigvalsh(Sigma - sig**2*I3)) < -1e-9:\n",
    "            continue\n",
    "        res = exact_gap(coupling, bridge, visible_dim=3, sigma_noise=sig, eps=CFG['brownian_epsilon'])\n",
    "        name = coupling if coupling != 'noisy_ot' else f'noisy OT sigma={sig}'\n",
    "        rows.append(dict(Bridge=bridge, Coupling=name, **res))\n",
    "exact_df = pd.DataFrame(rows)\n",
    "exact_df\n"
   ]

    "from torchvision.datasets import CIFAR10\n",
    "\n",
    "tfm=transforms.Compose([transforms.ToTensor(),transforms.Lambda(lambda x:x*2-1)])\n",
    "train_ds=CIFAR10(\"/kaggle/working/data\",train=True,download=True,transform=tfm)\n",
    "test_ds=CIFAR10(\"/kaggle/working/data\",train=False,download=True,transform=tfm)\n",
    "x_train=torch.stack([train_ds[i][0] for i in range(len(train_ds))])\n",
    "x_val=torch.stack([test_ds[i][0] for i in range(len(test_ds))])\n",
    "seed_all(123)\n",
    "z_train=torch.randn_like(x_train); z_val=torch.randn_like(x_val)\n",
    "\n",
    "def build_ot_perm(z,x,batch_size=128):\n",
    "    perm=np.empty(len(x),dtype=np.int64)\n",
    "    for start in tqdm(range(0,len(x),batch_size),desc=\"OT batches\"):\n",
    "        stop=min(start+batch_size,len(x))\n",
    "        cost=torch.cdist(z[start:stop].flatten(1),x[start:stop].flatten(1)).numpy()\n",
    "        row,col=linear_sum_assignment(cost)\n",
    "        perm[start+row]=start+col\n",
    "    return perm\n",
    "\n",
    "t0=time.time()\n",
    "ot_tr=build_ot_perm(z_train,x_train,128)\n",
    "ot_va=build_ot_perm(z_val,x_val,128)\n",
    "ind_tr=np.random.default_rng(303).permutation(len(x_train))\n",
    "ind_va=np.random.default_rng(404).permutation(len(x_val))\n",
    "RUNTIME.add(\"pair_bank\",time.time()-t0,n_train=len(x_train),ot_batch=128)"
   ]

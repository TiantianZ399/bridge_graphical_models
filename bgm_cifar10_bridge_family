    "            s,t,u=tr(CFG.train_batch)\n",
    "            loss=sum_mse(model(s,t),u)\n",
    "            opt.zero_grad(set_to_none=True); loss.backward()\n",
    "            torch.nn.utils.clip_grad_norm_(model.parameters(),1.0); opt.step()\n",

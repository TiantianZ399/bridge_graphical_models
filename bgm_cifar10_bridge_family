    "def timestep_embedding(t, dim=64, max_period=10000):\n",
    "    half = dim // 2\n",
    "    freqs = torch.exp(-math.log(max_period) * torch.arange(half, device=t.device) / half)\n",
    "    args = t[:, None] * freqs[None]\n",
    "    emb = torch.cat([torch.cos(args), torch.sin(args)], dim=-1)\n",
    "    if dim % 2:\n",
    "        emb = F.pad(emb, (0,1))\n",
    "    return emb\n",
    "\n",
    "class ResBlock(nn.Module):\n",
    "    def __init__(self, cin, cout, temb_dim):\n",
    "        super().__init__()\n",
    "        self.norm1 = nn.GroupNorm(min(8, cin), cin)\n",
    "        self.conv1 = nn.Conv2d(cin, cout, 3, padding=1)\n",
    "        self.norm2 = nn.GroupNorm(min(8, cout), cout)\n",
    "        self.conv2 = nn.Conv2d(cout, cout, 3, padding=1)\n",
    "        self.temb = nn.Linear(temb_dim, cout)\n",
    "        self.skip = nn.Conv2d(cin, cout, 1) if cin != cout else nn.Identity()\n",
    "    def forward(self, x, temb):\n",
    "        h = self.conv1(F.silu(self.norm1(x)))\n",
    "        h = h + self.temb(temb)[:, :, None, None]\n",
    "        h = self.conv2(F.silu(self.norm2(h)))\n",
    "        return h + self.skip(x)\n",
    "\n",
    "class TimeUNet(nn.Module):\n",
    "    def __init__(self, channels=3, base=48, temb_dim=128):\n",
    "        super().__init__()\n",
    "        self.temb_dim = temb_dim\n",
    "        self.time_mlp = nn.Sequential(\n",
    "            nn.Linear(64, temb_dim), nn.SiLU(), nn.Linear(temb_dim, temb_dim)\n",
    "        )\n",
    "        self.inp = nn.Conv2d(channels, base, 3, padding=1)\n",
    "        self.r1 = ResBlock(base, base, temb_dim)\n",
    "        self.down1 = nn.Conv2d(base, base*2, 4, 2, 1)\n",
    "        self.r2 = ResBlock(base*2, base*2, temb_dim)\n",
    "        self.down2 = nn.Conv2d(base*2, base*4, 4, 2, 1)\n",
    "        self.mid1 = ResBlock(base*4, base*4, temb_dim)\n",
    "        self.mid2 = ResBlock(base*4, base*4, temb_dim)\n",
    "        self.up2 = nn.ConvTranspose2d(base*4, base*2, 4, 2, 1)\n",
    "        self.u2 = ResBlock(base*4, base*2, temb_dim)\n",
    "        self.up1 = nn.ConvTranspose2d(base*2, base, 4, 2, 1)\n",
    "        self.u1 = ResBlock(base*2, base, temb_dim)\n",
    "        self.out = nn.Sequential(nn.GroupNorm(min(8, base), base), nn.SiLU(),\n",
    "                                 nn.Conv2d(base, channels, 3, padding=1))\n",
    "    def forward(self, x, t):\n",
    "        te = self.time_mlp(timestep_embedding(t, 64))\n",
    "        h0 = self.inp(x)\n",
    "        h1 = self.r1(h0, te)\n",
    "        h2 = self.r2(self.down1(h1), te)\n",
    "        hm = self.mid2(self.mid1(self.down2(h2), te), te)\n",
    "        u2 = self.u2(torch.cat([self.up2(hm), h2], 1), te)\n",
    "        u1 = self.u1(torch.cat([self.up1(u2), h1], 1), te)\n",
    "        return self.out(u1)\n",
    "\n",
    "@torch.no_grad()\n",
    "def evaluate_model(model, sampler_fn, n_batches, batch_size, seed):\n",
    "    model.eval()\n",
    "    seed_all(seed)\n",
    "    vals = []\n",
    "    for _ in range(n_batches):\n",
    "        state, t, target = sampler_fn(batch_size)\n",
    "        pred = model(state, t)\n",
    "        vals.append(sum_mse(pred, target).item())\n",
    "    return float(np.mean(vals))\n",
    "\n",
    "def train_one_model(\n",
    "    sampler_fn, channels, base, steps, batch_size, lr, seed,\n",
    "    val_batches=20, log_every=500\n",
    "):\n",
    "    seed_all(seed)\n",
    "    model = TimeUNet(channels=channels, base=base).to(DEVICE)\n",
    "    opt = torch.optim.AdamW(model.parameters(), lr=lr, weight_decay=1e-4)\n",
    "    ema = []\n",
    "    t0 = time.time()\n",
    "    model.train()\n",
    "    for step in range(1, steps+1):\n",
    "        state, t, target = sampler_fn(batch_size)\n",
    "        pred = model(state, t)\n",
    "        loss = sum_mse(pred, target)\n",
    "        opt.zero_grad(set_to_none=True)\n",
    "        loss.backward()\n",
    "        torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n",
    "        opt.step()\n",
    "        ema.append(loss.item())\n",
    "        if len(ema) > 100:\n",
    "            ema.pop(0)\n",
    "        if step == 1 or step % log_every == 0 or step == steps:\n",
    "            print(f\"step={step}/{steps} loss={loss.item():.3f} ema100={np.mean(ema):.3f}\")\n",
    "    sync()\n",
    "    seconds = time.time() - t0\n",
    "    train_mse = float(np.mean(ema))\n",
    "    val_mse = evaluate_model(model, sampler_fn, val_batches, batch_size, seed+10000)\n",
    "    del model, opt\n",
    "    gc.collect()\n",
    "    if torch.cuda.is_available():\n",
    "        torch.cuda.empty_cache()\n",
    "    return train_mse, val_mse, seconds"
   ]

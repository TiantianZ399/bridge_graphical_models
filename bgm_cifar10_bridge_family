    "canon_dim=32 if 32 in CFG.proxy_dims else CFG.proxy_dims[0]\n",
    "canon_k=32 if 32 in CFG.proxy_ks else CFG.proxy_ks[0]\n",
    "canon=proxy_df.query(\"pca_dim==@canon_dim and k==@canon_k\")\n",
    "merged=summary.merge(canon,on=[\"design\",\"family\",\"bridge\"])\n",
    "merged.to_csv(OUT/\"cifar10_bridge_proxy_vs_downstream.csv\",index=False)\n",
    "\n",
    "scopes={\n",
    " \"same_endpoint_ot\":merged.query(\"family=='same_endpoint'\"),\n",
    " \"brownian_noise_family\":merged.query(\"family=='brownian'\"),\n",
    " \"all_same_endpoint_plus_brownian\":merged.query(\"family in ['same_endpoint','brownian']\"),\n",
    " \"all_designs_descriptive\":merged,\n",
    "}\n",
    "preds=[\"proxy_local_variance\",\"proxy_crossfit_mse\",\"eta_local\",\n",
    "       \"endpoint_cost\",\"sample_target_variance\"]\n",
    "corr=[]\n",
    "for name,sub in scopes.items():\n",
    "    if len(sub)>=3:\n",
    "        corr+=correlation_rows(sub,[\"train_mse_mean\",\"val_mse_mean\"],preds,name)\n",
    "corr_df=pd.DataFrame(corr)\n",
    "corr_df.to_csv(OUT/\"cifar10_bridge_correlations.csv\",index=False)\n",
    "\n",
    "stability=[]\n",
    "for metric in [\"proxy_local_variance\",\"proxy_crossfit_mse\"]:\n",
    "    for k in CFG.proxy_ks:\n",
    "        piv=proxy_df.query(\"k==@k\").pivot(index=\"design\",columns=\"pca_dim\",values=metric)\n",
    "        for i,a in enumerate(piv.columns):\n",
    "            for b in piv.columns[i+1:]:\n",
    "                stability.append({\"metric\":metric,\"axis\":\"pca_dim\",\"fixed_k\":k,\n",
    "                                  \"a\":a,\"b\":b,\"spearman\":spearmanr(piv[a],piv[b]).statistic})\n",
    "    for dim in CFG.proxy_dims:\n",
    "        piv=proxy_df.query(\"pca_dim==@dim\").pivot(index=\"design\",columns=\"k\",values=metric)\n",
    "        for i,a in enumerate(piv.columns):\n",
    "            for b in piv.columns[i+1:]:\n",
    "                stability.append({\"metric\":metric,\"axis\":\"k\",\"fixed_pca_dim\":dim,\n",
    "                                  \"a\":a,\"b\":b,\"spearman\":spearmanr(piv[a],piv[b]).statistic})\n",
    "stability_df=pd.DataFrame(stability)\n",
    "stability_df.to_csv(OUT/\"cifar10_bridge_rank_stability.csv\",index=False)\n",
    "\n",
    "runtime=RUNTIME.frame();runtime.to_csv(OUT/\"cifar10_bridge_runtime.csv\",index=False)\n",
    "display(merged.sort_values(\"val_mse_mean\"))\n",
    "display(corr_df)\n",
    "display(stability_df.groupby([\"metric\",\"axis\"])[\"spearman\"].agg([\"mean\",\"min\"]))\n",
    "display(runtime)\n",
    "\n",
    "latex_cols=[\"design\",\"val_mse_mean\",\"val_mse_sd\",\"proxy_local_variance\",\n",
    "            \"proxy_crossfit_mse\",\"sample_target_variance\"]\n",
    "(OUT/\"cifar10_bridge_main_table.tex\").write_text(\n",
    "    merged[latex_cols].sort_values(\"val_mse_mean\").to_latex(\n",
    "        index=False,float_format=lambda x:f\"{x:.3f}\",escape=True))\n",
    "print(\"saved:\",sorted(p.name for p in OUT.iterdir()))"
   ]

    "designs=[\n",
    " {\"name\":\"straight_linear_ot\",\"family\":\"same_endpoint\",\"bridge\":\"linear\",\"coupling\":\"ot\"},\n",
    " {\"name\":\"straight_power2_ot\",\"family\":\"same_endpoint\",\"bridge\":\"power2\",\"coupling\":\"ot\"},\n",
    " {\"name\":\"straight_smoothstep_ot\",\"family\":\"same_endpoint\",\"bridge\":\"smoothstep\",\"coupling\":\"ot\"},\n",
    " {\"name\":\"vp_cosine_ot\",\"family\":\"same_endpoint\",\"bridge\":\"vp_cosine\",\"coupling\":\"ot\"},\n",
    " {\"name\":\"brownian_eps015_ot\",\"family\":\"brownian\",\"bridge\":\"brownian\",\"eps\":0.15,\"coupling\":\"ot\"},\n",
    " {\"name\":\"brownian_eps035_ot\",\"family\":\"brownian\",\"bridge\":\"brownian\",\"eps\":0.35,\"coupling\":\"ot\"},\n",
    " {\"name\":\"brownian_eps060_ot\",\"family\":\"brownian\",\"bridge\":\"brownian\",\"eps\":0.60,\"coupling\":\"ot\"},\n",
    " {\"name\":\"ve_corruption\",\"family\":\"ve\",\"bridge\":\"ve\",\"coupling\":\"paired\"},\n",
    " {\"name\":\"straight_linear_independent\",\"family\":\"coupling_reference\",\"bridge\":\"linear\",\"coupling\":\"independent\"},\n",
    "]\n",
    "\n",
    "def schedule(t, kind):\n",
    "    if kind==\"linear\":\n",
    "        return t, torch.ones_like(t)\n",
    "    if kind==\"power2\":\n",
    "        return t*t, 2*t\n",
    "    if kind==\"smoothstep\":\n",
    "        return 3*t*t-2*t*t*t, 6*t-6*t*t\n",
    "    raise ValueError(kind)\n",
    "\n",
    "def bridge_sample(z,x,t,design):\n",
    "    tv=t[:,None,None,None]\n",
    "    kind=design[\"bridge\"]\n",
    "    if kind in (\"linear\",\"power2\",\"smoothstep\"):\n",
    "        s,sp=schedule(t,kind)\n",
    "        sv=s[:,None,None,None]; spv=sp[:,None,None,None]\n",
    "        state=(1-sv)*z+sv*x\n",
    "        target=spv*(x-z)\n",
    "    elif kind==\"vp_cosine\":\n",
    "        a=torch.cos(math.pi*t/2)[:,None,None,None]\n",
    "        b=torch.sin(math.pi*t/2)[:,None,None,None]\n",
    "        ap=(-math.pi/2*torch.sin(math.pi*t/2))[:,None,None,None]\n",
    "        bp=( math.pi/2*torch.cos(math.pi*t/2))[:,None,None,None]\n",
    "        state=a*z+b*x\n",
    "        target=ap*z+bp*x\n",
    "    elif kind==\"brownian\":\n",
    "        eps=design[\"eps\"]; xi=torch.randn_like(z)\n",
    "        state=(1-tv)*z+tv*x+eps*torch.sqrt(tv*(1-tv))*xi\n",
    "        target=(x-state)/(1-tv)\n",
    "    elif kind==\"ve\":\n",
    "        r=1-t\n",
    "        ratio=CFG.ve_sigma_max/CFG.ve_sigma_min\n",
    "        sig=CFG.ve_sigma_min*(ratio**r)\n",
    "        sigv=sig[:,None,None,None]\n",
    "        state=x+sigv*z\n",
    "        # d sigma(1-t)/dt = -log(ratio)*sigma\n",
    "        target=(-math.log(ratio)*sigv)*z\n",
    "    else:\n",
    "        raise ValueError(kind)\n",
    "    return state,target\n",
    "\n",
    "def pair_bank(design,split):\n",
    "    z=z_train if split==\"train\" else z_val\n",
    "    x=x_train if split==\"train\" else x_val\n",
    "    if design[\"coupling\"]==\"ot\":\n",
    "        p=ot_tr if split==\"train\" else ot_va\n",
    "        return z,x[p]\n",
    "    if design[\"coupling\"]==\"independent\":\n",
    "        p=ind_tr if split==\"train\" else ind_va\n",
    "        return z,x[p]\n",
    "    return z,x\n",
    "\n",
    "def make_sampler(design_name,split=\"train\",seed=0):\n",
    "    d=next(q for q in designs if q[\"name\"]==design_name)\n",
    "    z,x=pair_bank(d,split)\n",
    "    gen=torch.Generator(device=\"cpu\").manual_seed(seed)\n",
    "    def sampler(bs):\n",
    "        idx=torch.randint(0,len(x),(bs,),generator=gen)\n",
    "        zb=z[idx].to(DEVICE); xb=x[idx].to(DEVICE)\n",
    "        t=(torch.rand(bs,generator=gen)*(CFG.t_max-CFG.t_min)+CFG.t_min).to(DEVICE)\n",
    "        state,target=bridge_sample(zb,xb,t,d)\n",
    "        return state,t,target\n",
    "    return sampler\n",
    "\n",
    "cost_rows=[]\n",
    "for d in designs:\n",
    "    z,x=pair_bank(d,\"train\")\n",
    "    # endpoint cost is meaningful for same endpoint/coupling rows.\n",
    "    cost=((x-z)**2).flatten(1).sum(1).mean().item()\n",
    "    cost_rows.append({\"design\":d[\"name\"],\"family\":d[\"family\"],\n",
    "                      \"bridge\":d[\"bridge\"],\"endpoint_cost\":cost})\n",
    "display(pd.DataFrame(cost_rows))"
   ]

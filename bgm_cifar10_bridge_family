    "def chunked_knn_stats(\n",
    "    train_feat: np.ndarray,\n",
    "    train_target: np.ndarray,\n",
    "    test_feat: np.ndarray,\n",
    "    test_target: np.ndarray,\n",
    "    k: int = 32,\n",
    "    chunk: int = 256,\n",
    "):\n",
    "    \"\"\"Two finite-sample proxies using a shared Euclidean feature space.\n",
    "\n",
    "    crossfit_mse: squared error of kNN conditional-mean prediction.\n",
    "    local_variance: average within-neighborhood target variance.\n",
    "\n",
    "    Both are sums over target coordinates, matching pixel-space sum-MSE.\n",
    "    \"\"\"\n",
    "    train_feat_t = torch.as_tensor(train_feat, dtype=torch.float32, device=DEVICE)\n",
    "    test_feat_t = torch.as_tensor(test_feat, dtype=torch.float32, device=DEVICE)\n",
    "    train_y_t = torch.as_tensor(train_target, dtype=torch.float32, device=DEVICE)\n",
    "    test_y_t = torch.as_tensor(test_target, dtype=torch.float32, device=DEVICE)\n",
    "    cf_sum, lv_sum, n = 0.0, 0.0, 0\n",
    "    for i in range(0, len(test_feat_t), chunk):\n",
    "        q = test_feat_t[i:i+chunk]\n",
    "        y = test_y_t[i:i+chunk]\n",
    "        dist = torch.cdist(q, train_feat_t)\n",
    "        idx = dist.topk(k=min(k, len(train_feat_t)), largest=False).indices\n",
    "        neigh = train_y_t[idx]\n",
    "        mu = neigh.mean(1)\n",
    "        cf = ((y - mu) ** 2).sum(1)\n",
    "        lv = ((neigh - mu[:, None]) ** 2).sum(2).mean(1)\n",
    "        cf_sum += cf.sum().item()\n",
    "        lv_sum += lv.sum().item()\n",
    "        n += len(q)\n",
    "    return {\n",
    "        \"proxy_crossfit_mse\": cf_sum / n,\n",
    "        \"proxy_local_variance\": lv_sum / n,\n",
    "    }\n",
    "\n",
    "def exact_spearman_p_permutation(rho: float, n: int):\n",
    "    # For perfect rankings, the exact two-sided permutation p-value is 2/n!.\n",
    "    if abs(abs(rho) - 1.0) < 1e-12 and n <= 10:\n",
    "        return 2.0 / math.factorial(n)\n",
    "    return np.nan\n",
    "\n",
    "def correlation_rows(df, outcome_cols, predictor_cols, scope):\n",
    "    rows = []\n",
    "    for outcome in outcome_cols:\n",
    "        for predictor in predictor_cols:\n",
    "            sub = df[[outcome, predictor]].dropna()\n",
    "            sr = spearmanr(sub[predictor], sub[outcome])\n",
    "            pr = pearsonr(sub[predictor], sub[outcome])\n",
    "            rows.append({\n",
    "                \"scope\": scope, \"outcome\": outcome, \"predictor\": predictor,\n",
    "                \"n_designs\": len(sub),\n",
    "                \"spearman_rho\": float(sr.statistic),\n",
    "                \"spearman_p_asymptotic\": float(sr.pvalue),\n",
    "                \"spearman_p_exact_if_perfect\": exact_spearman_p_permutation(float(sr.statistic), len(sub)),\n",
    "                \"pearson_r\": float(pr.statistic),\n",
    "                \"pearson_p\": float(pr.pvalue),\n",
    "            })\n",
    "    return rows\n",
    "\n",
    "def fit_common_pca(feature_banks: Dict[str, np.ndarray], pca_dim: int, max_fit: int, seed: int):\n",
    "    \"\"\"Fit one common PCA basis pooled across candidate designs.\"\"\"\n",
    "    rng = np.random.default_rng(seed)\n",
    "    pooled = []\n",
    "    per = max(100, max_fit // len(feature_banks))\n",
    "    for arr in feature_banks.values():\n",
    "        idx = rng.choice(len(arr), min(per, len(arr)), replace=False)\n",
    "        pooled.append(arr[idx])\n",
    "    pooled = np.concatenate(pooled, 0)\n",
    "    scaler = StandardScaler(with_mean=True, with_std=True)\n",
    "    pooled_s = scaler.fit_transform(pooled)\n",
    "    pca = PCA(n_components=min(pca_dim, pooled_s.shape[1]), random_state=seed)\n",
    "    pca.fit(pooled_s)\n",
    "    return scaler, pca"

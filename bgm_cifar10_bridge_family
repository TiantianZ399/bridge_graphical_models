    "def collect_proxy_arrays(d,n_total,seed):\n",
    "    sampler=make_sampler(d[\"name\"],\"train\",seed)\n",
    "    states=[]; targets=[]; times=[]\n",
    "    bs=128\n",
    "    n=0\n",
    "    while n<n_total:\n",
    "        take=min(bs,n_total-n)\n",
    "        s,t,u=sampler(take)\n",
    "        states.append(s.detach().cpu().flatten(1).numpy())\n",
    "        targets.append(u.detach().cpu().flatten(1).numpy())\n",
    "        times.append(t.detach().cpu().numpy()[:,None]); n+=take\n",
    "    return np.concatenate(states),np.concatenate(targets),np.concatenate(times)\n",
    "\n",
    "t0=time.time()\n",
    "arrays={d[\"name\"]:collect_proxy_arrays(d,CFG.proxy_total,11) for d in designs}\n",
    "feature_banks={k:np.concatenate([v[0],v[2]],1) for k,v in arrays.items()}\n",
    "rows=[]\n",
    "for dim in CFG.proxy_dims:\n",
    "    scaler,pca=fit_common_pca(feature_banks,dim,max_fit=15000,seed=11)\n",
    "    for k in CFG.proxy_ks:\n",
    "        for d in designs:\n",
    "            st,u,tt=arrays[d[\"name\"]]\n",
    "            feat=pca.transform(scaler.transform(np.concatenate([st,tt],1)))\n",
    "            ntr=min(CFG.proxy_train,len(feat)-100)\n",
    "            stats=chunked_knn_stats(feat[:ntr],u[:ntr],feat[ntr:],u[ntr:],\n",
    "                                    k=k,chunk=128)\n",
    "            var=((u[ntr:]-u[ntr:].mean(0))**2).sum(1).mean()\n",
    "            row={\"design\":d[\"name\"],\"family\":d[\"family\"],\"bridge\":d[\"bridge\"],\n",
    "                 \"pca_dim\":dim,\"k\":k,\"sample_target_variance\":float(var),**stats}\n",
    "            row[\"eta_local\"]=row[\"proxy_local_variance\"]/row[\"sample_target_variance\"]\n",
    "            row[\"eta_crossfit\"]=row[\"proxy_crossfit_mse\"]/row[\"sample_target_variance\"]\n",
    "            rows.append(row)\n",
    "proxy_df=pd.DataFrame(rows).merge(pd.DataFrame(cost_rows),\n",
    "                                  on=[\"design\",\"family\",\"bridge\"])\n",
    "proxy_df.to_csv(OUT/\"cifar10_bridge_proxy_sweep.csv\",index=False)\n",
    "RUNTIME.add(\"proxy_sweep\",time.time()-t0,n_rows=len(proxy_df))\n",
    "display(proxy_df.head())"
